// ── Tägliche Mitteilungen ────────────────────────────────────────────────────

model DailyMessage {
  id        String   @id @default(cuid())
  title     String
  content   String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation(fields: [createdBy], references: [id])
}

// ── Umfragen (Dashboard-Banner) ──────────────────────────────────────────────

model DailyPoll {
  id               String            @id @default(cuid())
  title            String
  question         String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean           @default(true)
  allowMultiple    Boolean           @default(false)
  allowFreeText    Boolean           @default(false)
  // true: Freitext wird durch eine Steam-Spielsuche ersetzt, Nutzer können mehrere Spiele vorschlagen
  freeTextGameMode Boolean           @default(false)
  rewardCoins      Int               @default(0)
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation(fields: [createdBy], references: [id])
  options          DailyPollOption[]
  votes            DailyPollVote[]
}

model DailyPollOption {
