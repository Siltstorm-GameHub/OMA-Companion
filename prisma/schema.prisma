generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  discordId    String?   @unique
  username     String?
  role         String    @default("user") // user | moderator | admin
  points       Int       @default(0) // Münzen (Shop-Währung)
  rankPoints   Int       @default(0) // Prestige-Punkte (Events, Turniere, LuL)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime? // Zeitpunkt der letzten App-Aktivität (Presence/Online-Status)
  lastLoginAt  DateTime? // Zeitpunkt des letzten Logins (NextAuth signIn)
  leftServerAt DateTime? // Gesetzt vom Member-Sync, wenn der User den Discord-Server verlassen hat (null = aktuell Mitglied). History/Punkte bleiben erhalten.

  twitchLogin        String?   @unique
  // Token für das persönliche OBS-Overlay (/overlay/profile/[userId]?token=…) — unabhängig von
  // jedem Event, nur für User mit gesetztem twitchLogin erreichbar. Lazy erzeugt wie Event.overlayToken.
  overlayToken       String?   @unique
  birthday           DateTime? // Nur Datum relevant (month/day)
  birthdayBoostUntil DateTime? // 2x Punkte bis zu diesem Zeitpunkt
  bio                String? // Kurzer Gruß / Beschreibung (max. 200 Zeichen)
  bannerUrl          String? // Eigenes Profil-Banner (Vercel Blob), 1200×300 empfohlen

  // Discord-Aktivität: kumulativ über alle Zeiten
  voiceMinutesTotal Int @default(0)
  messagesTotal     Int @default(0)

  // Battle Cards: aktuelle/beste Sieges-Serie in PVP-Kämpfen (Challenge + Matchmaking,
  // keine Testkämpfe), siehe lib/battle-cards/win-streak.ts
  battleWinStreak     Int @default(0)
  battleBestWinStreak Int @default(0)

  // Battle Cards: getrennte Elo-Ratings je Spielmodus (siehe lib/battle-cards/elo.ts),
  // saisonal sanft zurückgesetzt (ranked-season.ts: softResetAllElo) statt komplett
  // genullt — die *Matches-Zähler laufen ab dem letzten Reset (Saisonwechsel ODER
  // Admin-Hard-Reset) neu von 0, sie steuern den höheren Platzierungs-K-Faktor.
  eloDuels        Int @default(1000)
  eloDuelsMatches Int @default(0)
  eloGems         Int @default(1000)
  eloGemsMatches  Int @default(0)

  // Badge Showcase: JSON-Array mit bis zu 3 Badge-Keys (system oder custom-id)
  showcaseBadgesJson String?
  // Vitrinen-Fächer: JSON-Objekt { "<slotIndex>": "pokal:<id>" | "trophy:<scopeType>:<scopeValue>" | "badge:<key>" | null }.
  // Fehlt ein Index, füllt loadRoomProfileCore das Fach automatisch (siehe room-profile-data.ts).
  // null als Wert = User hat das Fach bewusst leer gelassen (kein Auto-Fill).
  vitrineSlotsJson   String?
  // Zeitpunkt der letzten Vitrinen-Änderung (Fach gesetzt/geleert/auf Auto zurückgestellt) —
  // treibt den "zuletzt aktualisiert"-Hinweis für Besucher (siehe VitrineModal.tsx).
  vitrineUpdatedAt   DateTime?
  // Aktuelle Lieblingsspiele: JSON-Array mit bis zu 5 { name, appId } (Steam App-ID für das Cover)
  favoriteGamesJson  String?
  // Notification-Präferenzen: JSON-Objekt { badge: bool, quest: bool, event: bool, points: bool, clip: bool, admin: bool }
  notificationPrefs  String    @default("{}")

  accounts                         Account[]
  sessions                         Session[]
  eventRegistrations               EventRegistration[]
  pointTransactions                PointTransaction[]
  tournamentParticipants           TournamentParticipant[]
  teamMemberships                  TeamMember[]
  squadMemberships                 SquadMembership[]
  matchEntries                     MatchEntry[]
  questProgress                    UserQuestProgress[]
  lulEntries                       LulEntry[]
  lulLegacyEntries                 LulLegacyEntry[]
  dailySpins                       DailySpin[]
  donations                        Donation[]
  lobbyMessages                    LobbyMessage[]
  pushSubscriptions                PushSubscription[]
  clipSubmissions                  EventClipSubmission[]
  clipNominations                  ClipNomination[]
  contestVotes                     ClipContestVote[]
  yearlyClipVotes                  YearlyClipContestVote[]
  eventPollVotes                   EventPollVote[]
  systemBadges                     UserSystemBadge[]
  customBadgeAwards                UserCustomBadge[]
  dailyMessages                    DailyMessage[]
  dailyPolls                       DailyPoll[]
  dailyPollVotes                   DailyPollVote[]
  eventPredictionsMade             EventWinnerPrediction[]     @relation("EventPredictionAuthor")
  eventPredictionsReceived         EventWinnerPrediction[]     @relation("EventPredictionTarget")
  predictionStreak                 PredictionStreak?
  duelChallengesSent               DuelChallenge[]             @relation("DuelChallenger")
  duelChallengesReceived           DuelChallenge[]             @relation("DuelOpponent")
  wanderpocalHoldings              WanderpocalHolder[]
  wanderpocalStats                 WanderpocalStat[]
  communityStreams                 EventCommunityStreamer[]
  linkedPartner                    Partner?
  notifications                    InAppNotification[]
  lulPollVotesGiven                LulPollVote[]               @relation("LulPollVoter")
  lulPollVotesReceived             LulPollVote[]               @relation("LulPollTarget")
  serverApplications               ServerApplication[]
  communityJobApplications         CommunityJobApplication[]
  communityJobApplicationsReviewed CommunityJobApplication[]   @relation("CommunityJobApplicationReviewer")
  communityJobMemberships          CommunityJobMember[]
  communityJobWeeklyPayouts        CommunityJobWeeklyPayout[]
  jobRecommendationDismissals      JobRecommendationDismissal[]
  jobReports                       JobReport[]
  jobReportVotes                   JobReportVote[]
  jobReportContributions           JobReportContribution[]
  jobReportContributionVotes       JobReportContributionVote[]
  jobMediaAssets                   JobMediaAsset[]
  jobMediaAlbums                   JobMediaAlbum[]
  marketingCampaigns               MarketingCampaign[]
  ideaInterests                    IdeaInterest[]
  promotionRequests                PromotionRequest[] @relation("PromotionRequester")
  jobMediaAssetVotes               JobMediaAssetVote[]
  marketingPosts                   MarketingPost[]
  marketingPostVotes               MarketingPostVote[]
  coachTrainingSessions            CoachTrainingSession[]
  coachTrainingSignups             CoachTrainingSignup[]
  coachRatingsReceived             CoachRating[]               @relation("CoachRatingTarget")
  coachRatingsGiven                CoachRating[]               @relation("CoachRatingRater")
  coachMenteesAsCoach              CoachMentee[]               @relation("CoachMenteeCoach")
  coachMenteesAsMentee             CoachMentee[]               @relation("CoachMenteeMentee")
  coachHelpReceived                CoachHelpRequest[]          @relation("CoachHelpReceived")
  coachHelpSent                    CoachHelpRequest[]          @relation("CoachHelpSent")
  coachOutreachSent                CoachOutreach[]             @relation("CoachOutreachSent")
  coachOutreachReceived            CoachOutreach[]             @relation("CoachOutreachReceived")
  coachGuides                      CoachGuide[]
  coachGuideVotes                  CoachGuideVote[]
  coachWaitlistEntries             CoachTrainingWaitlistEntry[]
  reportSeries                     ReportSeries[]
  photoRequests                    PhotoRequest[]              @relation("PhotoRequester")
  interviewsAsJournalist           InterviewRequest[]          @relation("InterviewJournalist")
  interviewsAsInterviewee          InterviewRequest[]          @relation("InterviewInterviewee")
  communityIdeas                   CommunityIdea[]
  communityIdeaVotes               CommunityIdeaVote[]
  communityBoardComments           CommunityBoardComment[]
  communityBoardCommentVotes       CommunityBoardCommentVote[]
  pokale                           Pokal[]
  battleCardUserCards              UserCard[]
  battleCardBattles                Battle[]                    @relation("BattleCardPlayer")
  battleCardPacks                  CardPack[]
  battleChallengesSent             BattleChallenge[]           @relation("BattleChallengeChallenger")
  battleChallengesReceived         BattleChallenge[]           @relation("BattleChallengeOpponent")
  battleQueueEntry                 BattleQueueEntry?
  liveBattlesAsA                   LiveBattle[]                @relation("LiveBattlePlayerA")
  liveBattlesAsB                   LiveBattle[]                @relation("LiveBattlePlayerB")
  campaignProgress                 UserCampaignProgress[]
  tutorialProgress                 UserTutorialProgress?
  gemsTournamentAttempts           GemsTournamentAttempt[]
  duelDecks                        DuelDeck[]
  userTacticCards                  UserTacticCard[]
}

// ── Pokale ───────────────────────────────────────────────────────────────────

model Pokal {
  id        String        @id @default(cuid())
  userId    String
  title     String // Titel des Events bzw. der Eventreihe zum Vergabezeitpunkt (Snapshot)
  category  EventCategory
  isSeries  Boolean       @default(false) // true = Eventreihen-Pokal (größer), false = Standalone-Event-Pokal
  eventId   String? // gesetzt bei Standalone-Event-Pokal
  seriesId  String? // gesetzt bei Eventreihen-Pokal
  awardedAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([userId, seriesId])
  @@index([userId])
}

// ── Täglicher Gratis-Spin ──────────────────────────────────────────────────
model DailySpin {
  id         String   @id @default(cuid())
  userId     String
  date       String // "YYYY-MM-DD" — ein Spin pro Tag
  prizeType  String // "points" | "nothing"
  prizeValue String // Punkte als String oder "0"
  prizeLabel String // Anzeigetext
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EventSeries {
  id                    String        @id @default(cuid())
  name                  String
  description           String?
  rules                 String? // Regelwerk, wird Usern über dem Punktesystem angezeigt
  icon                  String? // Lucide-Icon-Name (aus src/lib/series-icons.ts), Fallback: Repeat
  coverImageUrl         String? // Eigenes Reihen-Bild (Vercel Blob); Events der Reihe erben es, wenn sie keins haben
  fixedGame             String? // Wenn gesetzt: alle Events der Reihe nutzen dieses Spiel
  fixedFormat           String? // Wenn gesetzt: alle Turniere der Reihe nutzen dieses Format
  discordChannelId      String? // Kanal-ID für Bot-Nachrichten aller Events dieser Reihe
  category              EventCategory @default(casual)
  genre                 EventGenre?
  platform              String? // Komma-getrennte Plattformen, z.B. "PC, Xbox"
  recurrenceType        String? // "weekly" | "biweekly" | "monthly"
  recurrenceMonthlyMode String? // "dayOfMonth" | "weekdayOfMonth" (nur bei monthly)
  // JSON: { participationPoints: 5, stats: [{ field: "Kills", pointsPer: 2, isWinnerStat?, isMatchWinStat? }], mvpStatField?: "MVP", defaultWinnerStatField?: "Kills", defaultWinnerTargetField?: "Siege", winnerStatKeys?: string[], matchWinStatKeys?: string[] }
  seriesStatConfig      String?
  // JSON: [{ userId, points, participations, stats: { Kills: 45 } }]
  legacyStandings       String?
  // JSON: { lastUpdated, processedEventIds: string[], raw: { userId: { participations, Kills, MVP, Siege, ... } } }
  seriesStandingsJson   String?
  // JSON: { participationCoins: 10, placements: [{ place: 1, coins: 500, rankPoints: 3 }, ...] }
  placementRewardsJson  String?
  // JSON: { enabled: bool, question: string, coins: 250, rankPoints: 3 }
  pollConfigJson        String?
  // JSON: [{ label, question, coins, rankPoints, type: "player"|"spectator" }]
  pollsConfigJson       String?
  // Saison-Archiv
  groupId               String? // verbindet alle Saisons derselben Reihe
  status                String        @default("active") // "active" | "archived"
  hidden                Boolean       @default(false) // true = nur im Admin sichtbar
  registrationLocked    Boolean       @default(false) // true = User können sich nicht selbst anmelden, nur Admins tragen Teilnehmer ein
  // Wenn gesetzt: sichtbar für alle, Spieler-Selbst-Anmeldung nur für Mitglieder dieses Squads
  // (Zuschauer-Anmeldung bleibt für alle offen). Unabhängig von registrationLocked — beide Felder
  // können kombiniert sein (dann sperrt registrationLocked ausnahmslos alle, auch Squad-Mitglieder).
  squadId               String?
  squad                 Squad?        @relation(fields: [squadId], references: [id])
  seasonNumber          Int? // 1, 2, 3 …
  archivedAt            DateTime?
  // JSON: analog zu event.completionData (overallWinnerIds, finalRanking, poll*, lockedAt)
  seriesCompletionData  String?
  createdAt             DateTime      @default(now())
  events                Event[]
  lulSeason             LulSeason?
}

model Event {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  rules               String? // Regelwerk, wird Usern über dem Punktesystem angezeigt
  game                String?
  genre               EventGenre?
  category            EventCategory @default(casual)
  startAt             DateTime
  endAt               DateTime? // Optionales Ende (Datum/Uhrzeit) — generisch für alle Event-Typen, siehe formatBerlinRange
  maxPlayers          Int?
  pointReward         Int           @default(50)
  spectatorMode       Boolean       @default(false)
  spectatorRewardJson String? // JSON: { coins: number, rankPoints: number }
  type                String        @default("community")
  status              String        @default("open")
  hidden              Boolean       @default(false) // true = nur im Admin sichtbar
  registrationLocked  Boolean       @default(false) // true = User können sich nicht selbst anmelden, nur Admins tragen Teilnehmer ein
  // Wenn gesetzt (oder über die Reihe geerbt): Spieler-Selbst-Anmeldung nur für Mitglieder dieses
  // Squads. Event bleibt für alle sichtbar, Zuschauer-Anmeldung bleibt offen.
  squadId             String?
  squad               Squad?        @relation(fields: [squadId], references: [id])
  coverImageUrl       String? // Eigenes Event-Bild (Vercel Blob). Leer = Spiel-Cover, sonst EventCoverDefault
  // Token für die öffentliche OBS-Overlay-Route (/overlay/[id]?token=…). Wird lazy bei der
  // ersten Streamer-Anmeldung erzeugt, ein Event hat höchstens einen Link für alle Streamer.
  overlayToken        String?       @unique
  // Live-Steuerungszustand des Overlays waehrend des Streams (Touchscreen-Widget) — JSON:
  // { hidden: ElementKey[], zoom: ElementKey | null }. Ueberschreibt NUR Sichtbarkeit/Zoom
  // zur Laufzeit, das per URL festgelegte Standardlayout (Position/Groesse) bleibt Basis.
  // Fehlt das Feld oder ist es leer, verhaelt sich das Overlay exakt wie zuvor (safe default).
  overlayControlJson  String?
  discordEventId      String?       @unique
  discordMessageId    String? // Message-ID der Bot-Ankündigung (zum nachträglichen Löschen)
  discordChannelId    String? // Kanal-ID für Bot-Nachrichten (überschreibt DISCORD_EVENTS_CHANNEL_ID)
  seriesId            String?
  reminderSentAt      DateTime? // Gesetzt wenn 24h-Erinnerung verschickt (verhindert Doppel-Sendung)
  // JSON: { mvpUserId?, winnerStatField?, seriesWinnerTargetField?, lockedAt }
  completionData      String?
  // Gesetzt, solange ein Abschluss läuft. Verhindert, dass zwei parallele Abschlüsse
  // beide gegen denselben Ausgangsstand rechnen und Belohnungen doppelt auszahlen.
  completionLockAt    DateTime?
  createdAt           DateTime      @default(now())

  // Ehem. Tournament-Felder (zusammengeführt)
  format                String? // single_elimination | double_elimination (Legacy, nicht mehr wählbar) | round_robin | liga (= round_robin mit Hin-/Rückrunde) | ffa | coop_stats | avg_stats
  tournamentStatus      String? // pending | active | complete | finalized
  pointsConfig          String? // JSON: {"1": 100, "2": 50, "3": 25} — legacy, nur Münzen
  statFields            String? // JSON: ["Kills","Assists"]
  // Event-eigene Stat-Punkte-Konfiguration — überschreibt die Reihen-weite seriesStatConfig für
  // dieses Event (nötig bei coop_stats-Reihen ohne festes Format/Spiel, wo sich die Stat-Felder
  // von Event zu Event ändern). JSON: { stats: [{ field, pointsPer }], winnerStatKeys?: string[],
  // matchWinStatKeys?: string[] } — nur gesetzte, nicht-leere Arrays überschreiben die Reihen-Werte.
  statConfigJson        String?
  finalRankingJson      String? // JSON: ["userId1","userId2"]
  finalRankingNote      String?
  // JSON: { participationCoins: 10, placements: [{ place: 1, coins: 500, rankPoints: 3 }, ...] }
  placementRewardsJson  String?
  // JSON: { enabled: bool, question: string, coins: 250, rankPoints: 3 }
  pollConfigJson        String?
  // JSON: [{ label, question, coins, rankPoints, type: "player"|"spectator" }]
  pollsConfigJson       String?
  // JSON: { winnerMode: "manual"|"bracket"|"stat", winnerStatField?: string }
  seriesEventConfigJson String?
  summary               String?
  twitchClipUrl         String?

  series             EventSeries?             @relation(fields: [seriesId], references: [id])
  lulSpieltag        LulSpieltag?
  registrations      EventRegistration[]
  participants       TournamentParticipant[]
  matches            Match[]
  teams              Team[]
  streamingPartners  EventPartner[]
  communityStreamers EventCommunityStreamer[]
  clipSubmissions    EventClipSubmission[]
  polls              EventPoll[]
  winnerPredictions  EventWinnerPrediction[]
  gemsTournament     GemsTournament?
  jobReports         JobReport[]
  jobMediaAssets     JobMediaAsset[]
  jobMediaAlbums     JobMediaAlbum[]
  marketingCampaigns MarketingCampaign[]
  marketingPosts     MarketingPost[]
}

// ── Event-Umfragen ────────────────────────────────────────────────────────────

model EventPoll {
  id                        String          @id @default(cuid())
  eventId                   String
  event                     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label                     String // z.B. "MVP"
  question                  String // z.B. "Wer war der MVP?"
  // "all" | "participants" | "players" | "spectators"
  voterEligibility          String          @default("all")
  // "players" | "spectators" | "custom"
  answerType                String          @default("players")
  // JSON: [{key: string, label: string}] — nur bei answerType="custom"
  customAnswers             String?
  startAt                   DateTime
  endAt                     DateTime
  participationCoins        Int             @default(0)
  participationSeriesPoints Int             @default(0)
  winnerCoins               Int             @default(0)
  winnerRankPoints          Int             @default(0)
  // JSON: ["userId1", "userId2"] — nach Auswertung gesetzt
  winnerIds                 String?
  // JSON: ["userId1", "userId2"] — von der Wahl ausgeschlossene Kandidaten (auch nachträglich, während die Umfrage läuft)
  excludedUserIds           String?
  // true wenn Belohnungen bereits vergeben wurden
  rewardsPaid               Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  votes                     EventPollVote[]
}

model EventPollVote {
  id        String    @id @default(cuid())
  pollId    String
  poll      EventPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User      @relation(fields: [voterId], references: [id], onDelete: Cascade)
  // userId (für players/spectators) oder custom answer key
  targetId  String
  isManual  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pollId, voterId])
}

// ── Clip-Einreichungen ────────────────────────────────────────────────────────

model EventClipSubmission {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  clipUrl   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ── Partner ──────────────────────────────────────────────────────────────────

model Partner {
  id          String         @id @default(cuid())
  name        String
  twitchLogin String         @unique
  logoUrl     String
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  // Optional link to a community member account
  userId      String?        @unique
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  events      EventPartner[]
}

model EventPartner {
  id        String  @id @default(cuid())
  eventId   String
  partnerId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([eventId, partnerId])
}

// ── Clip des Monats ───────────────────────────────────────────────────────────

model MonthlyClipContest {
  id                  String            @id @default(cuid())
  month               Int // Anzeige-Monat (Monat von periodStart)
  year                Int
  periodStart         DateTime          @default(now()) // Beginn des bewerteten Clip-Zeitraums
  periodEnd           DateTime          @default(now()) // Ende des bewerteten Clip-Zeitraums
  votingEndsAt        DateTime          @default(now()) // Wann die Abstimmung automatisch endet/ausgewertet wird
  channelsJson        String? // JSON: string[] — abgefragte Twitch-Kanäle
  status              String            @default("voting") // voting | finished
  participationCoins  Int               @default(10) // Münzen für jeden, der abstimmt
  rewardCoins         Int               @default(500) // Münzen für den Gewinner-Clip
  winnerNominationIds String[]          @default([]) // Bei Gleichstand: mehrere Gewinner möglich
  createdAt           DateTime          @default(now())
  nominations         ClipNomination[]
  votes               ClipContestVote[]

  @@index([month, year])
}

model ClipNomination {
  id                 String             @id @default(cuid())
  contestId          String
  clipUrl            String
  thumbnailUrl       String?
  clipTitle          String?
  submittedByUserId  String? // Community-Clip: User der eingereicht hat
  twitchCreatorLogin String? // Partner-Clip: Twitch-Login des Clip-Erstellers
  partnerTwitchLogin String? // Partner-Clip: Twitch-Login des Kanals
  contest            MonthlyClipContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submittedBy        User?              @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  votes              ClipContestVote[]
  createdAt          DateTime           @default(now())
}

model ClipContestVote {
  id           String             @id @default(cuid())
  contestId    String
  nominationId String
  userId       String
  contest      MonthlyClipContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  nomination   ClipNomination     @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([contestId, userId])
}

// ── Clip des Jahres ──────────────────────────────────────────────────────────
// Jährliche Umfrage über alle Clip-des-Monats-Gewinner. Referenziert bestehende
// ClipNomination-Zeilen lose per ID (keine FK-Relation möglich, da eine
// ClipNomination bereits fest an ihren MonthlyClipContest gebunden ist).

model YearlyClipContest {
  id                  String                  @id @default(cuid())
  year                Int                     @unique // Jahr, in dem die Umfrage läuft; deckt Dez(year-1) bis Nov(year) ab
  votingEndsAt        DateTime                @default(now())
  status              String                  @default("voting") // voting | finished
  participationCoins  Int                     @default(10)
  rewardCoins         Int                     @default(1000)
  nominationIds       String[]                @default([]) // ClipNomination-IDs der Monatssieger dieses Zeitraums
  winnerNominationIds String[]                @default([])
  createdAt           DateTime                @default(now())
  votes               YearlyClipContestVote[]
}

model YearlyClipContestVote {
  id           String            @id @default(cuid())
  contestId    String
  nominationId String // ClipNomination.id — lose Referenz, keine FK-Relation
  userId       String
  contest      YearlyClipContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([contestId, userId])
}

// Community members who self-register as streamer for an event
model EventCommunityStreamer {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventRegistration {
  id       String   @id @default(cuid())
  userId   String
  eventId  String
  joinedAt DateTime @default(now())
  attended Boolean  @default(false)
  role     String   @default("player") // "player" | "spectator"
  user     User     @relation(fields: [userId], references: [id])
  event    Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

model TournamentParticipant {
  id         String  @id @default(cuid())
  eventId    String
  userId     String
  seed       Int?
  eliminated Boolean @default(false)
  finalRank  Int?
  event      Event   @relation(fields: [eventId], references: [id])
  user       User    @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

// Nur für team_vs_team-Formate
model Team {
  id           String       @id @default(cuid())
  eventId      String
  name         String
  color        String?
  event        Event        @relation(fields: [eventId], references: [id])
  members      TeamMember[]
  matchEntries MatchEntry[]
}

// ── Squads (persistente eSports-Teams, z.B. "Rocket League Team") ─────────────
// Bewusst NICHT "Team" genannt — das ist oben bereits ein anderes, event-gebundenes
// Konzept (Team A/B innerhalb eines einzelnen Turniers). Ein Squad existiert unabhängig
// von einzelnen Events, ein User kann Mitglied in mehreren Squads gleichzeitig sein.
model Squad {
  id            String   @id @default(cuid())
  name          String
  game          String? // z.B. "Rocket League" — rein informativ, keine feste Bindung
  description   String?
  icon          String? // Lucide-Icon-Name (aus src/lib/series-icons.ts), Fallback: Repeat
  color         String? // Hex-Farbe für Badges — Fallback über resolveSeriesColor(icon)
  coverImageUrl String? // Eigenes Squad-Bild (Vercel Blob), z.B. Team-Foto/Banner — analog zu EventSeries.coverImageUrl
  hidden        Boolean  @default(false) // true = nur im Admin sichtbar
  createdAt     DateTime @default(now())

  memberships SquadMembership[]
  events      Event[]
  eventSeries EventSeries[]
}

model SquadMembership {
  id       String   @id @default(cuid())
  squadId  String
  userId   String
  role     String   @default("member") // "member" | "captain"
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model Match {
  id          String       @id @default(cuid())
  eventId     String
  round       Int
  position    Int
  title       String?
  scheduledAt DateTime?
  notes       String?
  // 1v1 / single_elimination: player1Id/player2Id/score1/score2/winnerId
  player1Id   String?
  player2Id   String?
  winnerId    String?
  score1      Int?
  score2      Int?
  playedAt    DateTime?
  event       Event        @relation(fields: [eventId], references: [id])
  // ffa / coop_stats / team_vs_team: eine Zeile pro Teilnehmer
  entries     MatchEntry[]
}

// Flexible Teilnehmer-Zeile für FFA, Coop und Team-Matches
model MatchEntry {
  id        String  @id @default(cuid())
  matchId   String
  // Entweder userId (Einzelspieler) oder teamId (Team)
  userId    String?
  teamId    String?
  placement Int? // Platzierung (1 = Erster)
  score     Int? // Numerischer Score/Punkte im Match
  // JSON: {"Kills": 12, "Assists": 3} — passend zu Tournament.statFields
  statsJson String?
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id])
  team      Team?   @relation(fields: [teamId], references: [id])
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  // VOICE_MINUTES | MESSAGES | EVENT_ATTEND | TOURNAMENT | POLL_VOTE | DAILY_SPIN | DUEL_PLAYED | PREDICTION_MADE | JOB_CLAIM
  // (maßgeblich ist QuestType in src/lib/quests.ts)
  // (TOURNAMENT ist aus der aktiven Rotation entfernt, existiert aber noch in historischen Quest-Zeilen)
  type        String
  target      Int
  reward      Int
  month       Int
  year        Int
  createdAt   DateTime @default(now())

  progress UserQuestProgress[]
}

model UserQuestProgress {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  current     Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  rewarded    Boolean   @default(false)

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

// ── Minigames: Event-Gesamtsieger-Vorhersage ────────────────────────────────

model EventWinnerPrediction {
  id                 String   @id @default(cuid())
  userId             String // wer tippt
  eventId            String
  // Vorhergesagter Gesamtsieger — beliebiger User, muss nicht am Event angemeldet sein
  predictedUserId    String
  // Eingesetzte Münzen — wird bei Abgabe/Änderung sofort abgebucht (Escrow), bei Löschung vor
  // Sperre zurückerstattet. Bei richtigem Tipp: wager + Gewinn; bei falschem: Einsatz verloren.
  wager              Int      @default(0)
  createdAt          DateTime @default(now())
  resolved           Boolean  @default(false)
  correct            Boolean? // null = noch nicht ausgewertet
  coinsAwarded       Int      @default(0)
  // Snapshot des PredictionStreak-Zustands (userId, current, best, lastPlayedDay) direkt vor dieser
  // Auflösung — ermöglicht sauberes Rückgängigmachen, falls der Event-Sieger nachträglich korrigiert
  // wird. Nur zu Anzeigezwecken relevant, hat keinen Einfluss auf die Pott-Auszahlung.
  streakSnapshotJson String?

  user          User  @relation("EventPredictionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  event         Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  predictedUser User  @relation("EventPredictionTarget", fields: [predictedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // ein Tipp pro User pro Event
}

// Persistierter Tages-Streak für Vorhersagen (rein kosmetisch, keine Auswirkung auf die Pott-Auszahlung)
model PredictionStreak {
  userId        String  @id
  current       Int     @default(0)
  best          Int     @default(0)
  lastPlayedDay String? // "YYYY-MM-DD" — letzter Tag mit korrekt aufgelöstem Tipp
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Minigames: 1v1 Münzen-Duell ──────────────────────────────────────────────

model DuelChallenge {
  id           String    @id @default(cuid())
  challengerId String
  opponentId   String
  wager        Int
  status       String    @default("pending") // pending | accepted | declined | expired | resolved
  // "coinflip" — v1 nur Server-RNG, Skill-Modi später denkbar
  mode         String    @default("coinflip")
  winnerId     String?
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  resolvedAt   DateTime?

  challenger User @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, opponentId, createdAt])
}

// ── Spendenpool ─────────────────────────────────────────────────────────────

model PoolExpense {
  id          String   @id @default(cuid())
  title       String // z.B. "Minecraft Server Oktober"
  description String? // optionale Details
  amount      Float // in Euro
  date        DateTime // Datum der Ausgabe
  createdAt   DateTime @default(now())
}

model PoolIdea {
  id            String   @id @default(cuid())
  title         String // z.B. "Neuer Gameserver"
  description   String? // optionale Details
  estimatedCost Float? // Schätzpreis in Euro
  createdAt     DateTime @default(now())
}

model Donation {
  id        String   @id @default(cuid())
  userId    String
  amount    Float // in Euro, nur für Admin sichtbar
  month     Int // 1–12
  year      Int
  note      String? // optionale Admin-Notiz
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  // Kein Unique-Constraint → mehrere Einträge pro User pro Monat möglich
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ── Bot-Konfiguration ────────────────────────────────────────────────────────

model BotConfig {
  key       String   @id // z.B. "event_new_enabled", "event_new_text"
  value     String // "true" / "false" / Freitext
  updatedAt DateTime @updatedAt
}

// ── Vereinheitlichte Notification-Registry ──────────────────────────────────

model NotificationRule {
  key         String @id // z.B. "event_new", "quest_completed"
  label       String
  description String
  category    String // events | tournaments | quests | badges | clips | rank | system

  pushEnabled        Boolean @default(true)
  inAppEnabled       Boolean @default(true)
  discordDmEnabled   Boolean @default(false)
  discordChanEnabled Boolean @default(true)
  discordChannelId   String? // leer = DISCORD_NEWS_CHANNEL_ID

  titleTemplate String
  bodyTemplate  String
  urlTemplate   String?

  reminderHoursBefore Int? // nur für "event_reminder" relevant

  // Event-Bezug: wenn true, verlinkt die Benachrichtigung automatisch zum konkreten
  // Event statt zum Ziel-Link oben, und eventAudience steuert den Empfängerkreis.
  isEventNotification Boolean @default(false)
  eventAudience       String  @default("all") // "all" | "participants" (Mitspieler + Zuschauer + Streamer des Events)

  // Soft-Delete: Zeile bleibt bestehen, damit der Seed-Lauf sie beim nächsten
  // Deploy nicht automatisch wieder anlegt (upsert fasst existierende Zeilen nicht an).
  deleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Level-Up-League ─────────────────────────────────────────────────────────

model LulSeason {
  id             String   @id @default(cuid())
  number         Int // Saison-Nummer (1, 2, ...)
  name           String? // optionaler Anzeigename
  period         String? // "Mai 2026 - Dezember 2026"
  totalSpieltage Int      @default(8)
  // upcoming | active | finished | archived
  status         String   @default("upcoming")
  // true = Vergangene Saison, Daten nur als Endergebnis importiert
  isLegacy       Boolean  @default(false)
  // JSON: { game, spectator, gameWinner, vote, dominion, dominionTriggers: string[], polls: [{statKey, label, points}] }
  pointsConfig   String?
  // Wenn gesetzt: diese Saison wird als normale EventSeries behandelt (neues System)
  seriesId       String?  @unique
  createdAt      DateTime @default(now())

  spieltage     LulSpieltag[]
  legacyEntries LulLegacyEntry[]
  series        EventSeries?     @relation(fields: [seriesId], references: [id])
}

// Aggregiertes Saison-Endergebnis für vergangene Saisons ohne Spieltag-Details
model LulLegacyEntry {
  id            String    @id @default(cuid())
  seasonId      String
  userId        String
  totalPts      Int       @default(0)
  asPlayer      Int       @default(0) // Einsätze als Mitspieler
  asSpectator   Int       @default(0) // Einsätze als Zuschauer
  wins          Int       @default(0) // Game Winner
  champs        Int       @default(0) // Community-Champ (Legacy)
  trost         Int       @default(0) // Trostpreis (Legacy)
  dominion      Int       @default(0) // Dominion Bonus
  votes         Int       @default(0) // Votes
  // JSON: { "communityChamp": 3, "trostpreis": 1, "mvp": 2 } – für neue flexible Saisons
  pollStatsJson String?
  season        LulSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId])
}

model LulSpieltag {
  id               String     @id @default(cuid())
  seasonId         String
  number           Int // 1-8
  isSpecial        Boolean    @default(false)
  title            String? // Titel für Special Events
  description      String? // Beschreibung für Special Events
  maxPlayers       Int? // Maximale Spieleranzahl
  tournamentFormat String? // single_elimination | double_elimination | round_robin | liga | ffa | coop_stats
  statFields       String? // JSON: ["Kills","Assists"] — für ffa/coop_stats/avg_stats
  matchesJson      String? // JSON: [{id,p1,p2,s1,s2,winner}] — für 1v1-Formate
  game             String? // "Brawlhalla" (optional bei Special Events)
  gameType         String? // "Beat-em Up"
  platform         String? // "PC/Konsole"
  scheduledAt      DateTime?
  discordEventId   String?    @unique
  // upcoming | active | umfrage | finished
  status           String     @default("upcoming")
  // JSON: {"1": 10, "2": 5, "3": 3} – Punkte pro Spielplatzierung
  pointsConfig     String?
  // Wenn gesetzt: dieser Spieltag ist auch als reguläres Event sichtbar
  eventId          String?    @unique
  season           LulSeason  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  event            Event?     @relation(fields: [eventId], references: [id])
  entries          LulEntry[]
  polls            LulPoll[]
}

model LulEntry {
  id             String      @id @default(cuid())
  spieltagId     String
  userId         String
  // player | spectator
  role           String      @default("player")
  // JSON number[]: Punkte pro Runde (max 10), nur für Mitspieler
  roundScores    String?
  totalGameScore Int         @default(0)
  placement      Int? // Spieltagsplatzierung (1 = Sieger)
  gameWinner     Boolean     @default(false) // Mitspieler-Sieg
  communityChamp Boolean     @default(false) // Zuschauer-Umfragesieg (Legacy + statKey="communityChamp")
  trostpreis     Boolean     @default(false) // Trostpreis-Umfrage (Legacy + statKey="trostpreis")
  voted          Boolean     @default(false) // hat an Umfrage teilgenommen
  dominionBonus  Boolean     @default(false) // 3 Siege in Folge
  lulPoints      Int         @default(0) // LUL-Punkte gesamt für diesen Spieltag
  statsJson      String? // JSON: {"Kills":12} — für ffa/coop_stats/avg_stats
  // JSON: ["communityChamp","trostpreis"] — gewonnene Umfragen via statKey (neue flexible Saisons)
  pollWinsJson   String?
  spieltag       LulSpieltag @relation(fields: [spieltagId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id])

  @@unique([spieltagId, userId])
}

// ── LUL In-App Voting ────────────────────────────────────────────────────────

// Eine konfigurierbare Umfrage pro Spieltag (mehrere möglich)
model LulPoll {
  id              String   @id @default(cuid())
  spieltagId      String
  // statKey aus pointsConfig.polls (z.B. "communityChamp", "trostpreis", "mvp")
  statKey         String
  label           String // Anzeigename, z.B. "Community Champ"
  question        String // z.B. "Wer war der beste Zuschauer?"
  // "player" | "spectator" — wer zur Auswahl steht
  type            String
  endsAt          DateTime
  // JSON: string[] — UserIds die ausgeschlossen sind
  excludedUserIds String?
  // open | closed
  status          String   @default("open")
  // JSON: string[] — UserIds die gewonnen haben (gesetzt beim Schließen)
  winnerIds       String?
  createdAt       DateTime @default(now())

  spieltag LulSpieltag   @relation(fields: [spieltagId], references: [id], onDelete: Cascade)
  votes    LulPollVote[]
}

// Eine Stimme pro User pro Umfrage — UPDATE erlaubt, DELETE nicht
model LulPollVote {
  id        String   @id @default(cuid())
  pollId    String
  voterId   String
  targetId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll   LulPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voter  User    @relation("LulPollVoter", fields: [voterId], references: [id])
  target User    @relation("LulPollTarget", fields: [targetId], references: [id])

  @@unique([pollId, voterId])
}

// ── Lobby-Chat ───────────────────────────────────────────────────────────────

model LobbyMessage {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(500)
  userId    String   @map("userid")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("createdat")

  @@index([createdAt])
  @@map("lobbymessage")
}

// ── Abzeichen ────────────────────────────────────────────────────────────────

// Automatisch vergebene System-Abzeichen (definiert in badges.ts)
model UserSystemBadge {
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeKey])
}

// Admin-erstellte Custom-Abzeichen
model CustomBadge {
  id        String            @id @default(cuid())
  icon      String // Emoji — Fallback, wenn imageUrl leer ist
  imageUrl  String? // Eigene Abzeichen-Grafik (Vercel Blob); hat Vorrang vor icon
  name      String
  desc      String
  category  String // "community" | "aktivitaet" | "events" | "turniere" | "punkte" | "special"
  coins     Int               @default(0) // optionale Münzen-Belohnung
  createdAt DateTime          @default(now())
  createdBy String // Admin-User-ID
  awards    UserCustomBadge[]
}

// Manuell vergebene Custom-Abzeichen
model UserCustomBadge {
  userId        String
  customBadgeId String
  earnedAt      DateTime    @default(now())
  awardedBy     String // Admin-User-ID
  note          String? // optionale Notiz vom Admin
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge         CustomBadge @relation(fields: [customBadgeId], references: [id], onDelete: Cascade)

  @@id([userId, customBadgeId])
}

// ── Wanderpokal ──────────────────────────────────────────────────────────────

model WanderpocalHolder {
  id         String   @id @default(cuid())
  userId     String
  scopeType  String // "category" | "genre"
  scopeValue String // z.B. "competitive", "arcade"
  winCount   Int
  heldSince  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scopeType, scopeValue])
  @@index([userId])
}

model WanderpocalStat {
  id         String @id @default(cuid())
  userId     String
  scopeType  String
  scopeValue String
  winCount   Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeValue])
  @@index([scopeType, scopeValue, winCount])
}

// ── Event-Enums ───────────────────────────────────────────────────────────────

enum EventCategory {
  competitive
  fun
  casual
  training
  community_event
  special
}

enum EventGenre {
  arcade
  beat_em_up
  sport
  racing
  shooter
  community
  strategy
  card_game
  board_game
}

// ── Tägliche Mitteilungen ────────────────────────────────────────────────────

model DailyMessage {
  id        String   @id @default(cuid())
  title     String
  content   String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation(fields: [createdBy], references: [id])
}

// ── Umfragen (Dashboard-Banner) ──────────────────────────────────────────────

model DailyPoll {
  id               String            @id @default(cuid())
  title            String
  question         String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean           @default(true)
  allowMultiple    Boolean           @default(false)
  allowFreeText    Boolean           @default(false)
  // true: Freitext wird durch eine Steam-Spielsuche ersetzt, Nutzer können mehrere Spiele vorschlagen
  freeTextGameMode Boolean           @default(false)
  rewardCoins      Int               @default(0)
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation(fields: [createdBy], references: [id])
  options          DailyPollOption[]
  votes            DailyPollVote[]
}

model DailyPollOption {
  id         String    @id @default(cuid())
  pollId     String
  poll       DailyPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label      String
  gameName   String?
  steamAppId Int?
  order      Int       @default(0)
}

model DailyPollVote {
  id            String    @id @default(cuid())
  pollId        String
  poll          DailyPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON: ["optionId1", "optionId2"] — bei allowMultiple ggf. mehrere
  optionIds     String?
  freeText      String?
  // JSON: [{name: string, appId: number|null}] — bei freeTextGameMode, mehrere Spielevorschläge
  freeTextGames String?
  createdAt     DateTime  @default(now())

  @@unique([pollId, userId])
}

// ── In-App-Benachrichtigungen ────────────────────────────────────────────────

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String   @map("userid")
  type      String // "badge" | "quest" | "event_result" | "event_start" | "points" | "coins" | "clip" | "admin" | "server"
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("createdat")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("inappnotification")
}

// ── Ranglisten-Snapshot ───────────────────────────────────────────────────────

model LeaderboardRankSnapshot {
  id       String   @id @default(cuid())
  takenAt  DateTime @default(now())
  // JSON: { [userId]: rank } – Rang jedes Users zum Snapshot-Zeitpunkt
  dataJson String
}

// ── Push-Benachrichtigungen ──────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("userid")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("createdat")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pushsubscription")
}

// ── Community-Gameserver ─────────────────────────────────────────────────────

model GameServer {
  id            String   @id @default(cuid())
  name          String
  game          String // Freitext, z.B. "Minecraft", "ARK: Survival Ascended"
  description   String?
  host          String // IP/Domain – nur für genehmigte User sichtbar
  port          String?
  password      String? // Server-Passwort – nur für genehmigte User sichtbar
  ampInstanceId String? // AMP-Controller Instance-ID für Live-Status/Spielerzahl
  queryType     String? // "amp" | "gamedig" — welches Live-Status-Backend genutzt wird (null = kein Live-Status)
  gamedigType   String? // GameDig "type"-Key für die direkte Abfrage, z.B. "enshrouded" oder "sdtd" (7 Days to Die)
  queryPort     String? // Query-Port für die direkte Abfrage, falls abweichend vom Connect-Port (`port`)
  queryTelnetPort     String? // Optional: Telnet-Port für Spielernamen (z.B. 7 Days to Die liefert Namen nur via Telnet)
  queryTelnetPassword String? // Optional: Telnet-Passwort, passend zu queryTelnetPort
  maxSlots      Int
  isActive      Boolean  @default(true)
  openAccess    Boolean  @default(false) // true = Zugangsdaten für jeden eingeloggten User ohne Bewerbung sichtbar
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications ServerApplication[]

  @@map("gameserver")
}

model ServerApplication {
  id              String    @id @default(cuid())
  serverId        String
  userId          String
  status          String    @default("pending") // pending | approved | denied | revoked | waitlisted
  message         String?
  adminNote       String?
  appliedAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  lastConnectedAt DateTime? // Zeitpunkt des letzten Klicks auf "Jetzt verbinden" (Info für Admins)

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId, status])
  @@map("serverapplication")
}

// ── Community-Jobs (aktive, community-bewertete Jobs — Journalist, Fotograf, ────
//    Marketing Manager, Coach/Manager, Visionär) — die alten, passiv Münzen
//    generierenden Idle-Jobs wurden abgeschafft. Siehe Plan "Community-Jobs mit
//    Büro/Werkstatt und Wochengehalt". Phase 1 (Fundament): Bewerbung/Mitgliedschaft/Wochengehalt,
//    jobspezifische Content-Modelle (JobReport etc.) folgen in späteren Phasen.

model CommunityJobApplication {
  id           String    @id @default(cuid())
  userId       String
  jobKey       String // Schlüssel aus src/lib/community-jobs.ts (kein FK — Katalog ist Code, keine Tabelle)
  status       String    @default("PENDING") // PENDING | REJECTED | WAITLISTED | ACTIVATED | WITHDRAWN
  message      String? // optionale Motivation des Bewerbers
  appliedAt    DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  activatedAt  DateTime? // gesetzt, sobald aus der Bewerbung eine aktive Mitgliedschaft wurde

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CommunityJobApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([jobKey, status])
  @@index([userId])
}

model CommunityJobMember {
  id     String @id @default(cuid())
  userId String
  jobKey String
  // ACTIVE | WARNED | REVOKED | QUIT | EXPIRED — bewusst KEIN @@unique([userId, jobKey]):
  // ein User kann denselben Job im Lauf der Zeit mehrfach innehaben (Kündigung → Sperrfrist
  // nach REVOKED → Neubewerbung), jede Zeile ist ein eigener "Amtszeit"-Datensatz.
  status String @default("ACTIVE")

  assignedAt          DateTime  @default(now())
  contractStartAt     DateTime  @default(now())
  contractEndAt       DateTime // = contractStartAt + 3 Monate, bei Verlängerung += 3 Monate
  renewedAt           DateTime?
  warnedAt            DateTime?
  warningReason       String?
  revokedAt           DateTime?
  reapplyBlockedUntil DateTime? // nur bei REVOKED gesetzt (Default revokedAt + 2 Wochen)
  lastContributionAt  DateTime? // für Inaktivitäts-Check
  availableUntil      DateTime? // Coach: "Ich bin jetzt für Ad-hoc-Hilfe verfügbar" bis zu diesem Zeitpunkt
  specialties         String[]  @default([]) // Coach: Spezialgebiete (Spiele/Sprachen), max. 6 Tags
  badgeLevel          Int       @default(1) // Ansehens-Stufe 1–4 (Badge hinter dem Usernamen), wöchentlich neu berechnet
  peakBadgeLevel      Int       @default(1) // höchste je erreichte Stufe dieser Amtszeit — bestimmt das "Ehem."-Zeichen
  handedOffFromUserId String? // Snapshot-Info für Transparenz-Historie, kein FK
  badgeOverrideUntil  DateTime? // Admin hat die Stufe von Hand gesetzt — der Wochen-Cron lässt sie bis dahin unverändert

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, jobKey])
  @@index([jobKey, status])
}

model CommunityJobWeeklyPayout {
  id                  String   @id @default(cuid())
  userId              String
  jobKey              String
  weekStart           DateTime
  weekEnd             DateTime
  rawScore            Float    @default(0)
  tierLabel           String? // Snapshot des angewendeten Stufennamens (z.B. "Herausragend"), null = keine Bewertung erhalten
  baseCoins           Int      @default(0) // Stufenbetrag vor Aktivitäts-Bonus
  voteBonusMultiplier Float    @default(1) // 1.0–2.0, aus eigenen abgegebenen Bewertungen dieser Woche
  coinsAwarded        Int      @default(0) // = round(baseCoins * voteBonusMultiplier)
  paidAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobKey, weekStart])
  @@index([jobKey, weekStart])
}

/**
 * "Nicht relevant" auf eine Büro-Empfehlung (Event ohne Bericht/Fotos/Werbung,
 * Coach-Terminhinweis, Visionär-Ideenhinweis) — blendet genau diesen Hinweis für
 * diesen User dauerhaft aus, ohne die Empfehlungslogik selbst zu verändern.
 * itemKey = die jeweilige EventRecommendation.eventId (bei synthetischen
 * Hinweisen wie "coach-no-upcoming-session" der feste String-Schlüssel).
 */
model JobRecommendationDismissal {
  id          String   @id @default(cuid())
  userId      String   @map("userid")
  jobKey      String   @map("jobkey")
  itemKey     String   @map("itemkey")
  dismissedAt DateTime @default(now()) @map("dismissedat")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobKey, itemKey])
  @@map("jobrecommendationdismissal")
}

// ── Journalist ───────────────────────────────────────────────────────────────

model JobReport {
  id                        String    @id @default(cuid())
  authorId                  String
  eventId                   String? // optional — ein Bericht kann, muss aber nicht an ein Event gekoppelt sein
  title                     String
  bodyMarkdown              String
  coverAssetId              String? // → JobMediaAsset (Fotograf-Bild als Cover)
  referencedMarketingPostId String? // → MarketingPost, falls der Bericht über eine Marketing-Aktion berichtet
  publishedAt               DateTime  @default(now())
  hiddenByAdminAt           DateTime? // redaktionelle Moderation, unabhängig von Stimmen-Anfechtungen
  hiddenReason              String?
  discordMessageId          String? // für Reaktions-Rückzuordnung (spätere Phase)
  category                  String? // turnierbericht | interview | meinung | guide | news (siehe report-categories.ts)
  isDraft                   Boolean   @default(false) // Entwurf: nur für den Autor sichtbar, nicht im Board, keine Bewertung
  seriesId                  String? // Berichtsreihe ("Teil 1–3"), nur eigene Reihen des Autors
  editedAt                  DateTime? // "Korrigiert am" — gesetzt, wenn ein veröffentlichter Bericht inhaltlich geändert wurde
  lastEditNote              String? // kurzer Korrekturhinweis zur letzten Änderung (öffentlich)
  notifiedMentions          String[]  @default([]) // User-IDs, die für @-Erwähnungen schon benachrichtigt wurden
  gameCoverUrl              String? // Spiel-Cover als Titelbild (statt Fotograf-Bild) — nur bekannte Cover-Hosts, siehe game-cover-url.ts
  gameCoverName             String?
  updatedAt                 DateTime  @default(now()) @updatedAt

  author                  User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event                   Event?                  @relation(fields: [eventId], references: [id])
  coverAsset              JobMediaAsset?          @relation(fields: [coverAssetId], references: [id])
  referencedMarketingPost MarketingPost?          @relation("ReportReferencesMarketingPost", fields: [referencedMarketingPostId], references: [id])
  series                  ReportSeries?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  revisions               JobReportRevision[]
  votes                   JobReportVote[]
  contributions           JobReportContribution[]

  @@index([eventId])
  @@index([authorId])
  @@index([seriesId])
}

/// Berichtsreihe eines Journalisten (z.B. "Turnier-Rückblick: Teil 1–3").
model ReportSeries {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  createdAt DateTime @default(now())

  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports JobReport[]

  @@index([authorId])
}

/// Frühere Fassung eines veröffentlichten Berichts (Versionsverlauf) — wird beim Überschreiben gesichert.
model JobReportRevision {
  id           String   @id @default(cuid())
  reportId     String
  title        String
  bodyMarkdown String
  note         String? // Korrekturhinweis der Änderung, die diese Fassung abgelöst hat
  savedAt      DateTime @default(now())

  report JobReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Bildwunsch eines Journalisten an die Fotografen.
model PhotoRequest {
  id               String    @id @default(cuid())
  requesterId      String
  eventId          String?
  description      String
  status           String    @default("OPEN") // OPEN | FULFILLED | CLOSED
  fulfilledAssetId String?
  fulfilledById    String?
  requesterJob     String? // Job des Anfragenden (journalist | marketing_manager | coach | visionaer)
  createdAt        DateTime  @default(now())
  fulfilledAt      DateTime?

  requester User @relation("PhotoRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requesterId])
}

/// Interview-Anfrage eines Journalisten an ein Community-Mitglied.
model InterviewRequest {
  id            String    @id @default(cuid())
  journalistId  String
  intervieweeId String
  questionsJson String // JSON: string[]
  answersJson   String? // JSON: string[] (gleiche Länge wie die Fragen)
  status        String    @default("PENDING") // PENDING | ANSWERED | DECLINED
  createdAt     DateTime  @default(now())
  answeredAt    DateTime?

  journalist User @relation("InterviewJournalist", fields: [journalistId], references: [id], onDelete: Cascade)
  interviewee User @relation("InterviewInterviewee", fields: [intervieweeId], references: [id], onDelete: Cascade)

  @@index([intervieweeId, status])
  @@index([journalistId])
}

model JobReportVote {
  id                  String   @id @default(cuid())
  reportId            String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String? // PENDING | UPHELD | OVERTURNED
  disputeResolvedById String?

  report JobReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  voter  User      @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([reportId, voterId])
}

/**
 * Ergänzung eines zweiten Journalisten zu einem bestehenden Bericht — eigener, unabhängig bewerteter Abschnitt.
 */
model JobReportContribution {
  id                  String   @id @default(cuid())
  reportId            String
  authorId            String
  bodyMarkdown        String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  report JobReport                   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User                        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  JobReportContributionVote[]

  @@index([reportId])
}

model JobReportContributionVote {
  id                  String   @id @default(cuid())
  contributionId      String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  contribution JobReportContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  voter        User                  @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([contributionId, voterId])
}

// ── Fotograf / gemeinsame Mediathek ──────────────────────────────────────────

model JobMediaAsset {
  id               String    @id @default(cuid())
  authorId         String
  eventId          String?
  type             String // CLIP | COLLAGE | SCREENSHOT | BANNER | GRAPHIC
  url              String // Vercel Blob, via bestehende /api/upload-Route
  caption          String?
  createdAt        DateTime  @default(now())
  usageCount       Int       @default(0) // hochgezählt, wenn ein anderer Job das Asset referenziert (z.B. als Report-Cover)
  hiddenByAdminAt  DateTime?
  hiddenReason     String?
  discordMessageId String?
  albumId          String? // optionales Album ("Grand Final 2026")

  author        User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event         Event?              @relation(fields: [eventId], references: [id])
  album         JobMediaAlbum?      @relation(fields: [albumId], references: [id], onDelete: SetNull)
  votes         JobMediaAssetVote[]
  usedAsCoverIn JobReport[]
  MarketingPost MarketingPost[]

  @@index([eventId])
  @@index([authorId])
  @@index([albumId])
}

/// Fotografen-Album: Bilder/Clips zu einer Serie zusammengefasst, als Ganzes verlinkbar.
model JobMediaAlbum {
  id        String   @id @default(cuid())
  authorId  String
  eventId   String?
  title     String
  createdAt DateTime @default(now())

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event  Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assets JobMediaAsset[]

  @@index([authorId])
  @@index([eventId])
}

model JobMediaAssetVote {
  id                  String   @id @default(cuid())
  assetId             String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  asset JobMediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  voter User          @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([assetId, voterId])
}

// ── Marketing Manager ────────────────────────────────────────────────────────

model MarketingPost {
  id                   String    @id @default(cuid())
  authorId             String
  eventId              String? // Event, für das geworben wird — leer nur bei Posts zu einem Coach-Training (trainingSessionId)
  trainingSessionId    String? // Post bewirbt einen Coach-Trainings-Termin (bewusst kein FK, wie bei CoachTrainingSession.eventId)
  assetId              String? // → JobMediaAsset (wiederverwendetes Fotograf-Bild aus der Mediathek)
  imageUrl             String? // eigene, im Studio erstellte Grafik (nicht aus der Fotograf-Mediathek — zählt zur eigenen Post-Bewertung, keine separate Attribution)
  caption              String
  createdAt            DateTime  @default(now())
  adminConfirmedPosted Boolean   @default(false) // Admin bestätigt: tatsächlich extern (z.B. Instagram) gepostet
  hiddenByAdminAt      DateTime?
  hiddenReason         String?
  discordMessageId     String?
  campaignId           String? // optionale Kampagne (Ankündigung → Erinnerung → Heute)
  kind                 String? // announce | reminder | lastspots | today — Baustein/Vorlage, aus der der Post entstand
  confirmedNotified    Boolean   @default(false) // Autor wurde über die externe Bestätigung informiert

  author              User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event               Event?              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset               JobMediaAsset?      @relation(fields: [assetId], references: [id])
  campaign            MarketingCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  votes               MarketingPostVote[]
  referencedByReports JobReport[]         @relation("ReportReferencesMarketingPost")

  @@index([eventId])
  @@index([authorId])
  @@index([campaignId])
}

/// Kampagne zu einem Event: mehrere Posts als Serie (Ankündigung, Erinnerung, "Heute").
model MarketingCampaign {
  id        String   @id @default(cuid())
  authorId  String
  eventId   String
  title     String
  createdAt DateTime @default(now())

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event  Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  posts  MarketingPost[]

  @@index([authorId])
  @@index([eventId])
}

model MarketingPostVote {
  id                  String   @id @default(cuid())
  postId              String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  post  MarketingPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  voter User          @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([postId, voterId])
}

// ── Coach/Manager ────────────────────────────────────────────────────────────
// Eigenständiges, leichtgewichtiges Trainings-Termin-Modell statt Wiederverwendung
// von Event — Event-Erstellung ist Moderatoren/Admins bzw. Squad-Captains (nur
// eigenes Squad) vorbehalten, siehe src/app/api/events/route.ts:49-60. Der Coach
// ist bewusst unabhängig von Squads.

model CoachTrainingSession {
  id          String   @id @default(cuid())
  coachId     String
  title       String
  description String?
  startAt     DateTime
  capacity    Int?
  createdAt   DateTime @default(now())
  eventId        String? // optional: Vorbereitungs-Training für ein Event (bewusst kein FK, wie handedOffFromUserId)
  seriesId       String? // gleiche ID für alle Termine einer Terminserie
  reminderSentAt DateTime? // Tages-Erinnerung an die Teilnehmer schon verschickt
  meetingUrl     String? // Treffpunkt (z.B. Discord-Voice-Kanal-Link)
  summary        String? // Nachbereitung: Zusammenfassung/Tipps des Coaches nach dem Termin

  coach   User                  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  signups  CoachTrainingSignup[]
  ratings  CoachRating[]
  waitlist CoachTrainingWaitlistEntry[]

  @@index([coachId])
  @@index([eventId])
}

/// Warteliste für ausgebuchte Termine — rückt automatisch nach, sobald ein Platz frei wird.
model CoachTrainingWaitlistEntry {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session CoachTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

/// "Hilfe anfragen" — unabhängig von der Verfügbarkeit des Coaches.
model CoachHelpRequest {
  id          String    @id @default(cuid())
  coachId     String
  requesterId String
  message     String
  status      String    @default("OPEN") // OPEN | ANSWERED
  reply       String?
  createdAt   DateTime  @default(now())
  answeredAt  DateTime?

  coach     User @relation("CoachHelpReceived", fields: [coachId], references: [id], onDelete: Cascade)
  requester User @relation("CoachHelpSent", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([coachId, status])
  @@index([requesterId, createdAt])
}

/// Protokoll versendeter Willkommens-/Einladungs-Nachrichten an Neulinge (verhindert Doppel-Versand).
model CoachOutreach {
  id        String   @id @default(cuid())
  coachId   String
  userId    String
  kind      String // "welcome" | "invite:<sessionId>"
  createdAt DateTime @default(now())

  coach User @relation("CoachOutreachSent", fields: [coachId], references: [id], onDelete: Cascade)
  user  User @relation("CoachOutreachReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coachId, userId, kind])
}

/// Einsteiger-Anleitungen des Coaches im Community-Board (Daumen-hoch-Bewertung wie bei Berichten).
model CoachGuide {
  id              String    @id @default(cuid())
  authorId        String
  title           String
  bodyMarkdown    String
  game            String?
  createdAt       DateTime  @default(now())
  hiddenByAdminAt DateTime?
  hiddenReason    String?

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CoachGuideVote[]

  @@index([authorId])
}

model CoachGuideVote {
  id                  String   @id @default(cuid())
  guideId             String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  guide CoachGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  voter User       @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([guideId, voterId])
}

model CoachTrainingSignup {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())
  attended  Boolean? // null = noch nicht eingetragen, sonst Anwesenheit laut Coach

  session CoachTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

/// Spieler, die ein Coach persönlich begleitet (privat für den Coach, mit Notiz).
model CoachMentee {
  id        String   @id @default(cuid())
  coachId   String
  menteeId  String
  note      String?
  createdAt DateTime @default(now())

  coach  User @relation("CoachMenteeCoach", fields: [coachId], references: [id], onDelete: Cascade)
  mentee User @relation("CoachMenteeMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([coachId, menteeId])
  @@index([coachId])
}

model CoachRating {
  id                  String   @id @default(cuid())
  coachId             String
  raterId             String
  trainingSessionId   String? // null = Ad-hoc-Bewertung ohne Trainings-Bezug
  stars               Int // 1-5
  reason              String // Pflichttext — bleibt privat, nur Coach + Admin sehen ihn
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  coach           User                  @relation("CoachRatingTarget", fields: [coachId], references: [id], onDelete: Cascade)
  rater           User                  @relation("CoachRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  trainingSession CoachTrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@unique([coachId, raterId, trainingSessionId])
  @@index([coachId])
}

// ── Visionär ─────────────────────────────────────────────────────────────────
// Bewusst eigenständig statt an Event gekoppelt — kein passendes bestehendes
// Umfrage-Modell (EventPoll hängt fest an einem Event). Bleibt laut Plan auch
// nach Ablauf der Abstimmungsfrist dauerhaft sicht- und bewertbar; `status`
// ist rein kosmetisch (keine harte Sperre für weitere Stimmen).

model CommunityIdea {
  id               String    @id @default(cuid())
  authorId         String
  title            String
  description      String
  status           String    @default("OPEN") // OPEN | CLOSED — nur UI-Kennzeichnung
  votingEndsAt     DateTime?
  createdAt        DateTime  @default(now())
  hiddenByAdminAt  DateTime?
  hiddenReason     String?
  discordMessageId String?
  category         String? // event | feature | app | server | other (siehe idea-lifecycle.ts)
  lifecycle        String    @default("OPEN") // OPEN | REVIEW | PLANNED | DONE | REJECTED — vom Team gesetzt
  lifecycleNote    String?
  lifecycleAt      DateTime?
  lifecycleById    String?
  sourceEventId    String? // Idee entstand zu diesem Event
  sourceReportId   String? // Idee entstand zu diesem Bericht
  endNotified      Boolean   @default(false) // Zusammenfassung nach Ablauf der Abstimmungsfrist verschickt
  imageUrls        String[]  @default([]) // bis zu 3 Bilder/Mockups (Vercel Blob)
  version          Int       @default(1) // Überarbeitungen ("Version 2")
  editedAt         DateTime? // Zeitpunkt der letzten inhaltlichen Überarbeitung
  lastEditNote     String?
  gameAppId        Int? // Steam-App-ID bei Spiele-Ideen
  gameName         String?
  notifiedMentions String[]  @default([]) // User-IDs, die für @-Erwähnungen schon benachrichtigt wurden
  draftEventId     String? // vom Team angelegter Event-Entwurf zu dieser Idee

  author User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommunityIdeaVote[]
  interests IdeaInterest[]
  revisions IdeaRevision[]

  @@index([authorId])
}

/// "Ich wäre dabei" (PARTICIPATE) bzw. "Ich helfe mit" (HELP) zu einer Idee.
model IdeaInterest {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  kind      String // PARTICIPATE | HELP
  createdAt DateTime @default(now())

  idea CommunityIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId, kind])
  @@index([userId])
}

/// Frühere Fassung einer Idee (Snapshot vor einer Überarbeitung).
model IdeaRevision {
  id          String   @id @default(cuid())
  ideaId      String
  version     Int
  title       String
  description String
  note        String?
  savedAt     DateTime @default(now())

  idea CommunityIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

/// Bereits verschickte Top-Ideen-Zusammenfassungen ("week-2026-09-14", "month-2026-08") — verhindert Doppel-Posts.
model IdeaDigest {
  id       String   @id @default(cuid())
  period   String   @unique
  postedAt DateTime @default(now())
}

model CommunityIdeaVote {
  id                  String   @id @default(cuid())
  ideaId              String
  voterId             String
  stars               Int // 1-5
  reason              String // Pflichttext — bleibt privat, nur Autor + Admin sehen ihn
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?
  revotedAt           DateTime? // letzte Neu-Bewertung nach einer Überarbeitung der Idee

  idea  CommunityIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  voter User          @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([ideaId, voterId])
}

// ── Community-Board: Kommentare ─────────────────────────────────────────────
// Generisches Kommentar-Modell für alle vier Feed-Typen (Report, Asset,
// Marketing-Post, Idee) statt vier separater Modelle — polymorph über
// entityType + entityId, weil Kommentieren job-übergreifend jedem offensteht
// (nicht nur dem jeweiligen Job-Inhaber). Bewertungen auf eigene Kommentare
// zählen — analog zu JobReportContributionVote beim Journalisten — zusätzlich
// in den Gehalts-Score des jeweils aktuellen Community-Jobs des Kommentators
// (siehe registerScoreResolver-Erweiterung in journalist/fotograf/
// marketing-manager/visionaer-service.ts).
model CommunityBoardComment {
  id                  String   @id @default(cuid())
  entityType          String // report | asset | marketing_post | idea
  entityId            String
  authorId            String
  bodyMarkdown        String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String? // PENDING | UPHELD | OVERTURNED
  disputeResolvedById String?

  author User                        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommunityBoardCommentVote[]

  @@index([entityType, entityId])
  @@index([authorId])
}

model CommunityBoardCommentVote {
  id                  String   @id @default(cuid())
  commentId           String
  voterId             String
  createdAt           DateTime @default(now())
  disputed            Boolean  @default(false)
  disputeReason       String?
  disputeResolution   String?
  disputeResolvedById String?

  comment CommunityBoardComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  voter   User                  @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([commentId, voterId])
}

// ============================================
// Battle Cards — Mini-Battler Kartenspiel
// ============================================
// Integriert aus dem eigenständigen "OMA Battle Cards"-Projekt. Nutzt die
// bestehende User-Tabelle oben direkt mit (battleCardUserCards /
// battleCardBattles) statt eines eigenen User-Modells.

enum CardClass {
  TANK
  DAMAGE_DEALER
  SUPPORT
}

enum CardRarity {
  STANDARD
  COMMUNITY
}

enum ActivityTier {
  GHOST // 💤 ×0.85
  NPC // 🎮 ×1.0
  GAMER // 🎖 ×1.15
  LEGENDE // 🔥 ×1.3
  OLD_MASTER // 👑 ×1.45
}

// Feste Normalangriff-Sonderregel einzelner Karten: einzelne Karten können
// feste Sonderregeln haben, z.B. Fernrohr greift immer höchste HP an.
// null/fehlend = Standard-Regel (niedrigste DEF).
enum NormalAttackTargetRule {
  LOWEST_DEFENSE
  HIGHEST_HP
  LOWEST_HP
  HIGHEST_ATTACK
  RANDOM
}

model Card {
  id         String     @id @default(cuid())
  name       String // z.B. "Bastionella"
  title      String // z.B. "Die Wächterin"
  class      CardClass
  rarity     CardRarity
  flavorText String

  // Basiswerte auf Stufe 1 (bei COMMUNITY-Karten: aus Generierung, außer überschrieben)
  baseHp                 Int
  baseAttack             Int
  baseDefense            Int
  speed                  Int // fix pro Karte, innerhalb Klassen-Spanne
  normalAttackTargetRule NormalAttackTargetRule? // null = Standard (niedrigste DEF)

  // Skills als strukturiertes JSON (flexibel für unterschiedliche Effekte)
  passivePositive Json // { name, description, trigger, effects: [...] }
  passiveNegative Json
  activeSkill     Json // { name, description, cost: 50, effects: [...] }
  ultimateSkill   Json // { name, description, cost: 100, effects: [...] }

  // Nur relevant bei rarity = COMMUNITY
  linkedDiscordId String?       @unique // Verknüpfung zum realen Community-Mitglied — 1 Karte pro Mitglied
  activityTier    ActivityTier? // aktuelle Saison-Stufe (Ghost...Old Master)
  sourceStatsJson Json? // Rohdaten-Snapshot, aus dem generiert wurde (Debugging/Nachvollziehbarkeit)

  // Override-Steuerung: welche Felder sind manuell fixiert und werden bei
  // der automatischen Saison-Generierung NICHT überschrieben.
  overriddenFields String[]  @default([])
  isAutoGenerated  Boolean   @default(false) // true = durch Pipeline erzeugt/zuletzt aktualisiert
  lastGeneratedAt  DateTime?

  imageUrl  String?
  // Charakter (Time-Elements-Baukasten, siehe src/lib/te-character): Ebenen-Auswahl des Users
  // für seine Community-Karte, zugleich seine Spielfigur in OMA Quest. Shape: TeCharacterConfig.
  // null = noch nicht angepasst (Karte zeigt das Discord-Profilbild bzw. Klassen-Icon).
  teCharacter Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userCards UserCard[]

  // --- OMA-Quest-Charakterbogen (nur relevant/befüllt für rarity = COMMUNITY) ---
  dndRace       String? // z.B. "Mensch", "Elf", "Zwerg", "Halbling", "Halbork" — ausgewürfelt
  dndClass      String? // volle OMA-Quest-Klasse (Krieger/Magier/Kleriker/Schurke/Waldläufer/...),
  // NICHT dasselbe wie class: CardClass — siehe DND_CLASS_TO_CARD_CLASS in src/lib/dnd/class-mapping.ts
  abilityScores Json? // { str, dex, con, int, wis, cha } — 4d6-drop-lowest, klassisch
  backstory     String? @db.Text // ausgewürfelt bei Erstellung, danach frei editierbar (kein overriddenFields-Kandidat)
  dndCreatedAt  DateTime? // wann der Charakter erstellt wurde (Gate: Erstellung nur einmal möglich)
  dndRerollCredits Int @default(0) // verfügbare Re-Rolls (Rasse+Klasse+Stats zusammen) — 1 gratis bei Erst-Erstellung
  // ODER Auto-Migration (kein eigener Wurf), danach im Shop nachkaufbar (buy-dnd-reroll), pro Nutzung -1
  dndXp         Int     @default(0) // Summe aus Story-Ereignissen + DndQuest.xpReward — rein kosmetisch/Fortschritt, kein Battle-Balance-Faktor

  // --- Standort & Reise (Hex-Weltkarte, siehe src/lib/dnd/hex) ---
  // Position = Hex-Feld (odd-r-Offset). currentLocationId ist die feste Location auf diesem Feld
  // (null = freies Feld ohne Location). Alte Charaktere ohne Hex-Position stehen implizit auf dem
  // Feld ihrer currentLocation (Backfill beim Lesen, siehe travel.ts positionOf).
  currentLocationId String?
  currentLocation    DndLocation? @relation(fields: [currentLocationId], references: [id])
  currentHexCol      Int?
  currentHexRow      Int?
  // Aktive Reise: Zielfeld + geplanter Pfad ([[col,row], …] inkl. Start) + Zeiten. travelToCol != null = unterwegs.
  travelToCol        Int?
  travelToRow        Int?
  travelPath         Json?
  travelDepartedAt   DateTime?
  travelArrivesAt    DateTime?

  eventLogs     DndEventLog[]
  questProgress DndQuestProgress[]

  @@index([currentLocationId])
}

// ============================================
// OMA-Quest-Weltkarte, Reisen, Story & Quests
// ============================================
// Story-Content selbst (Ereignis-/Backstory-Texte) ist prozedural aus
// hartcodierten gewichteten Tabellen gezogen (src/lib/dnd/*), NIE per LLM-Call
// — kostenfrei, wie in der Planung festgelegt. DndStoryNode ist die
// Ereignis-DEFINITION (Pool-Eintrag je Location-Typ), DndEventLog ist der
// tatsächlich gewürfelte, resolvierte Verlaufseintrag je Charakter.

enum DndLocationType {
  SETTLEMENT // Stadt/Dorf — Handel, NPC-Dialoge, sichere Zone, Quest-Geber
  DUNGEON // Ruine/Verlies — Kämpfe, Loot, klassische Rollenspiel-Encounter
  WILDERNESS // Wald/Sumpf/Berge — Erkundung, Sammeln, Zufallsbegegnungen
  LANDMARK // besonderer Ort — Story-/Lore-lastige Einzelereignisse
}

model DndLocation {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String?         @db.Text
  locationType    DndLocationType
  hexCol          Int             @default(0) // Feld auf der Hex-Weltkarte (world.json), siehe lib/dnd/hex
  hexRow          Int             @default(0)
  mapIcon         String?
  backgroundImage String?
  order           Int             @default(0)

  storyNodes DndStoryNode[]
  quests     DndQuest[]
  cards      Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ereignis-DEFINITION (Vorlage) — kein Charakterbezug, sondern ein Pool-Eintrag,
// aus dem beim Story-Tick pro Location(-Typ) gewichtet gezogen wird. Die
// tatsächlich einem Charakter widerfahrene Instanz landet in DndEventLog.
model DndStoryNode {
  id           String           @id @default(cuid())
  slug         String           @unique
  locationId   String?
  location     DndLocation?     @relation(fields: [locationId], references: [id])
  locationType DndLocationType? // falls locationId leer: Pool gilt für ALLE Locations dieses Typs
  weight       Int              @default(10)
  title        String
  text         String           @db.Text
  xpReward     Int              @default(0)
  createdAt    DateTime         @default(now())

  eventLogs DndEventLog[]
}

// Resolvierter Verlaufseintrag je Charakter ("was ist wann passiert") — das,
// was im Story-Panel der Location-Szene gerendert wird (nach locationId
// gefiltert). Deckt auch "zwei Charaktere trafen sich hier" ab (kein
// separates DndEncounter-Modell nötig für v1).
model DndEventLog {
  id          String        @id @default(cuid())
  cardId      String
  card        Card          @relation(fields: [cardId], references: [id])
  locationId  String
  storyNodeId String?
  storyNode   DndStoryNode? @relation(fields: [storyNodeId], references: [id])
  title       String
  text        String        @db.Text
  xpGained    Int           @default(0)
  occurredAt  DateTime      @default(now())

  @@index([cardId, occurredAt])
  @@index([locationId, occurredAt])
}

model DndQuest {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String       @db.Text
  objectiveType   String // z.B. "MONSTER_SLAIN", "LOCATION_VISITED", "MESSAGE_SENT", "VOICE_MINUTES",
  // "EVENT_ATTEND", "POLL_VOTE", "BATTLE_CARD_DUEL", "STORY_NODE_COMPLETED"
  targetCount     Int
  targetRef       String? // optionale Entitäts-Referenz, z.B. locationSlug
  xpReward        Int          @default(0)
  itemReward      Json?
  coinReward      Int          @default(0) // > 0: zusätzlich über den bestehenden Coins-Pfad vergeben
  linkedQuestType String? // optionaler QuestType (quests-meta.ts) — löst zusätzlich die normale Monats-Quest aus
  locationId      String?
  location        DndLocation? @relation(fields: [locationId], references: [id])
  createdAt       DateTime     @default(now())

  progress DndQuestProgress[]
}

model DndQuestProgress {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id])
  questId     String
  quest       DndQuest  @relation(fields: [questId], references: [id])
  current     Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  rewarded    Boolean   @default(false)

  @@unique([cardId, questId])
}

model UserCard {
  id         String   @id @default(cuid())
  userId     String
  cardId     String
  level      Int      @default(1) // 1-5
  duplicates Int      @default(1) // gesamt erhaltene Kopien (inkl. verbrauchte für Upgrades)
  inLineup   Boolean  @default(false) // Teil der aktuellen Startaufstellung (max. 5 pro User)
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId]) // ein UserCard-Eintrag pro Karte pro User
}

enum BattleResult {
  WIN
  LOSS
  DRAW
}

model Battle {
  id           String       @id @default(cuid())
  playerId     String
  opponentType String // z.B. "PVE_STANDARD", "PVP", "EVENT_BOSS"
  result       BattleResult
  teamSnapshot Json // Team-Zusammenstellung zum Zeitpunkt des Kampfes
  battleLog    Json // vollständiger Rundenverlauf für Replay/Debugging
  createdAt    DateTime     @default(now())

  player User @relation("BattleCardPlayer", fields: [playerId], references: [id])
}

// ── Karten-Packs ─────────────────────────────────────────────────────────────
// Packs lösen sich NICHT automatisch auf — Kauf/Gewinn legt nur ein
// ungeöffnetes Pack ins Inventar, geöffnet wird manuell auf /battle-cards
// (mit Öffnen-Animation im Client). PURCHASE ist zusätzlich auf maximal
// 5 Käufe/Tag begrenzt (siehe lib/battle-cards/packs.ts).

enum CardPackSource {
  PURCHASE
  WHEEL
  TUTORIAL
  GEMS_PVP_CHEST
  GEMS_TOURNAMENT_REWARD
}

// Pack-Sorte bestimmt Kartenanzahl + Community-Karten-Chance beim Öffnen,
// siehe COMMUNITY_CHANCE/PACK_CARD_COUNT in lib/battle-cards/packs.ts.
enum CardPackKind {
  STANDARD
  PREMIUM
  COMMUNITY
}

model CardPack {
  id               String         @id @default(cuid())
  userId           String
  source           CardPackSource
  kind             CardPackKind   @default(STANDARD)
  // Garantiert beim Öffnen GENAU diese Karte statt einer zufälligen Ziehung
  // (siehe openNextPack in packs.ts) — bisher nur für das Tutorial-Community-
  // Pack genutzt (garantiert die eigene Community-Karte des Users).
  guaranteedCardId String?
  createdAt        DateTime       @default(now())
  openedAt         DateTime?
  openedCardId     String? // Snapshot der gezogenen Karten-ID, rein informativ

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ── Battle-Cards-Duelle (ersetzt das alte Münzen-Duell als Herausforderung
// zwischen zwei Usern) ─────────────────────────────────────────────────────
// Löst sich sofort bei Annahme auf (kein separates "Wird gespielt" nötig —
// die Kampf-Engine ist deterministisch/serverseitig, keine Live-Eingabe).

model BattleChallenge {
  id               String    @id @default(cuid())
  challengerId     String
  opponentId       String
  status           String    @default("pending") // pending | live | declined | resolved | expired
  // "DUELS" (Yu-Gi-Oh-artiges Deck/Feld-PvP, mit Annahme-Schritt — Wert bewusst unverändert
  // gelassen, obwohl die Engine dahinter komplett neu ist: leaderboard.ts und die
  // Battle-Cards-Seite filtern hart auf diesen String für die Rangliste, ein neuer Wert
  // hätte neue Duelle dort stillschweigend verschwinden lassen) | "GEMS" (asynchroner
  // Match-3-Ghost-Angriff, startet direkt mit status="live", kein "pending"/Annahme) — beide
  // zählen gemeinsam in die Saison-Rangliste (siehe leaderboard.ts), sind dort aber auch einzeln
  // filterbar.
  mode             String    @default("DUELS")
  liveBattleId     String?   @unique // gesetzt während status="live", verweist auf LiveBattle.id
  battleId         String? // gesetzt sobald resolved, verweist auf Battle.id
  winnerId         String?
  createdAt        DateTime  @default(now())
  respondedAt      DateTime?
  // false = zählt NICHT für Rangliste/Sieges-Kiste — bei GEMS-Kämpfen gesetzt, sobald dasselbe
  // Angreifer/Gegner-Paar am selben Tag bereits GEMS_PVP_OPPONENT_DAILY_CAP resolvte Kämpfe hatte
  // (verhindert Farmen: denselben Gegner beliebig oft anzugreifen darf keine beliebig große
  // Rangliste-/Belohnungswirkung haben, siehe finalizeLiveBattle). Für DUELS immer true.
  countsForRanking Boolean   @default(true)

  challenger User @relation("BattleChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("BattleChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, opponentId, createdAt])
}

// ── OMA Duels (Yu-Gi-Oh-artiges Live-PvP) — Deck-Auswahl ────────────────────
// Ersetzt die alte 5er-PVE-Lineup (lineup.ts) als Kampf-Zusammenstellung für
// diesen Modus: Duell-Decks sind größer (fix DUEL_DECK_TOTAL_SIZE Karten,
// siehe duel-constants.ts) und mischen Einheiten- mit Taktik-Karten.
model DuelDeck {
  id            String   @id @default(cuid())
  userId        String
  name          String   @default("Standard")
  unitCardIds   String[] // Card-IDs, mind. DUEL_DECK_MIN_UNIT_CARDS
  tacticCardIds String[] // TacticCard-IDs, Rest bis DUEL_DECK_TOTAL_SIZE
  isActive      Boolean  @default(true) // aktuell für PVP_DUELS_LIVE-Herausforderungen gewähltes Deck
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TacticCardKind {
  INSTANT // wirkt sofort beim Ausspielen (Items, z.B. Energy-Drinks)
  TRAP // verdeckt gesetzt, wirkt bei Trigger-Bedingung (z.B. Server-Lag)
}

// Items/Fallen fürs OMA-Duels-Deck — humorvoller Gaming-Bezug (Energy-Drinks,
// Fast-Food, Lag, Rage-Quit, ...), gleicher Ton wie puzzle-monsters.ts.
model TacticCard {
  id               String         @id @default(cuid())
  name             String
  kind             TacticCardKind
  flavorText       String
  description      String
  effects          Json // wiederverwendet Effect-Typen aus battle-engine/types.ts
  triggerCondition Json? // nur TRAP, z.B. { type: "onEnemyAttack" }
  imageUrl         String? // extern per ComfyUI generiert, per Admin-Upload gesetzt (wie Card.imageUrl)
  rarity           CardRarity     @default(STANDARD)
  createdAt        DateTime       @default(now())

  userTacticCards UserTacticCard[]
}

model UserTacticCard {
  id           String @id @default(cuid())
  userId       String
  tacticCardId String
  quantity     Int    @default(1)

  user       User       @relation(fields: [userId], references: [id])
  tacticCard TacticCard @relation(fields: [tacticCardId], references: [id])

  @@unique([userId, tacticCardId])
}

// ── Interaktive Kämpfe (Zug-für-Zug, Spieler steuert Ziel/Ultimate-Aktivierung) ─
// Ein LiveBattle hält den seriell fortsetzbaren Kampf-Zustand (siehe
// lib/battle-engine/interactive.ts) zwischen den einzelnen Zug-Requests. Für
// PVE ist playerBId null (Team B = KI/NPC), bei PVP steuern beide Spieler
// ihre eigene Seite. Nach Abschluss wird das Ergebnis wie bisher in ein
// normales Battle (+ ggf. BattleChallenge) übernommen und LiveBattle bleibt
// nur noch als Verlaufs-Datensatz stehen (status="finished").
model LiveBattle {
  id             String   @id @default(cuid())
  // "PVE_EASY" | "PVE_MEDIUM" | "PVE_HARD" | "PVE_PUZZLE_EASY" | "PVE_PUZZLE_MEDIUM" | "PVE_PUZZLE_HARD"
  // | "PVP_DUELS_LIVE" | "PVP_GEMS" | "CAMPAIGN_<levelId>" (campaign-levels.ts)
  // | "TOURNAMENT_<gemsTournamentId>" (siehe GemsTournament unten)
  // "PVP_CHALLENGE"/"PVP_MATCHMAKING" sind der abgelöste alte sequentielle Duell-Modus —
  // nur noch für bereits laufende/abgeschlossene Alt-Kämpfe relevant, wird nicht mehr neu vergeben.
  mode           String
  playerAId      String
  playerBId      String? // null = Team B ist NPC/KI-gesteuert
  stateJson      Json
  status         String   @default("active") // active | finished
  resultBattleId String?  @unique // gesetzt sobald finished, verweist auf Battle.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  playerA User  @relation("LiveBattlePlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB User? @relation("LiveBattlePlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@index([playerAId])
  @@index([playerBId])
}

// ── OMA-Gems-Turniere (Score-Attack) ────────────────────────────────────────
// Ein Admin legt im generischen Event-Admin-Bereich (/admin/events) ein Event
// mit game === "OMA Gems" an — das hängt automatisch diesen Datensatz an.
// Alle Teilnehmer kämpfen im Zeitraum [Event.startAt, endAt] gegen dasselbe
// feste Gegner-Team (bossTeamJson, einmalig bei Erstellung erzeugt, damit die
// Ergebnisse fair vergleichbar sind), ihr bester Score zählt fürs Ranking.
// Belohnungen nutzen das bereits vorhandene Event.placementRewardsJson.
model GemsTournament {
  id                 String    @id @default(cuid())
  eventId            String    @unique
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // DEPRECATED: zugunsten von Event.endAt. Bleibt optional (statt entfernt) bestehen, weil
  // bestehende Produktionsdaten hier liegen und ohne Live-DB-Zugriff kein sicheres
  // Backfill+Drop in einem Schritt möglich ist — siehe scripts/backfill-gems-event-endat.ts.
  // Neue Turniere setzen dieses Feld nicht mehr, nur noch Event.endAt.
  endAt              DateTime?
  difficulty         String    @default("MEDIUM") // NpcDifficulty: EASY | MEDIUM | HARD
  maxAttemptsPerUser Int       @default(3)
  bossTeamJson       String
  // Admin-gewählte Boss-Team-Zusammensetzung (JSON-Array von MonsterTemplate.cardId,
  // Duplikate erlaubt, siehe gems-monster-catalog.ts) — null/leer bedeutet: bossTeamJson
  // wurde per Zufallsauswahl erzeugt (siehe generateGemsTournamentBossTeam). Wird nur zur
  // Anzeige/Neuberechnung im Edit-Formular gebraucht, nicht für die Kampflogik selbst.
  monsterCardIdsJson String?
  finalizedAt        DateTime? // gesetzt vom Cron nach Auszahlung der Platzierungsbelohnungen
  createdAt          DateTime  @default(now())

  attempts GemsTournamentAttempt[]
}

model GemsTournamentAttempt {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   GemsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bestScore    Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([tournamentId, userId])
}

// ── Battle-Cards-Kampagne ("Edelstein-Kampf", siehe campaign-levels.ts) ────
// Level-Inhalte (Gegner, Schwierigkeit, Münz-Belohnung) sind bewusst hart in
// TypeScript hinterlegt (campaign-levels.ts) statt in der DB — hier landet
// nur der Spieler-Fortschritt je Level. `levelId` referenziert die id aus
// campaign-levels.ts als freier String, keine FK (Level-Inhalte leben
// außerhalb der DB und werden per Deploy gepflegt, siehe puzzle-monsters.ts
// für dasselbe Muster bei den Schnellkampf-Gegnern).
model UserCampaignProgress {
  id          String    @id @default(cuid())
  userId      String
  levelId     String
  // Beste je erzielte Sternebewertung (1-3) für dieses Level, 0 = noch nie gewonnen.
  stars       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
}

// ── Battle-Cards-Tutorial ────────────────────────────────────────────────
// Startet, sobald ein User sein Start-Pack wählt (siehe grantStarterPick in
// starter-pick.ts) — nicht rückwirkend für User, die ihr Start-Pack schon
// vor Einführung des Tutorials gewählt hatten. Ein Saison-1-Reset (siehe
// resetAllCardOwnership) zwingt User zurück in StarterPickFlow, was dieses
// Tutorial automatisch neu startet (grantStarterPick setzt alle Felder
// zurück auf null, siehe tutorial.ts: startOrResetTutorial).
model UserTutorialProgress {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  npcBattleCompletedAt      DateTime? // Schritt 1: NPC-Kampf (Einfach) gespielt — +200 Münzen, Community-Pack
  communityCardCustomizedAt DateTime? // Schritt 2: eigene Community-Karte bearbeitet — +500 Münzen
  campaignLevel1CompletedAt DateTime? // Schritt 3: Kampagne Kapitel 1, Level 1 gewonnen — Premium-Pack
  completedAt               DateTime? // alle Schritte erledigt
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Battle-Cards-Matchmaking ("Zufallsgegner suchen") ───────────────────────
// Ein User legt sich per Warteschlangen-Eintrag rein; der nächste, der ebenfalls
// beitritt, matched sich sofort gegen den ältesten wartenden Eintrag — es startet
// direkt ein interaktiver LiveBattle (siehe oben), beide steuern ihre Seite selbst.
// matchedChallengeId wird auf dem Eintrag des zuerst Wartenden gesetzt, damit
// dessen Poll-Request den LiveBattle findet — der Eintrag wird danach von diesem
// Poll konsumiert (gelöscht).
model BattleQueueEntry {
  id                 String   @id @default(cuid())
  userId             String   @unique
  createdAt          DateTime @default(now())
  matchedChallengeId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Protokoll aller Admin-/Moderator-Aktionen in den Community-Jobs (Wer, Was, Wann, Grund).
model CommunityJobAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String?
  action      String
  targetType  String? // member | application | report | asset | marketing_post | idea | guide | comment | album | campaign | photo_request | job | payout
  targetId    String?
  targetUserId String?
  targetLabel String? // Name/Titel zum Zeitpunkt der Aktion (Snapshot)
  jobKey      String?
  reason      String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetUserId])
}

/// Ergebnis jedes Laufs des täglichen Community-Job-Crons — damit der Admin sieht, ob und was gelaufen ist.
model CommunityJobCronRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  durationMs Int
  hadError   Boolean  @default(false)
  resultJson String

  @@index([ranAt])
}

/// Werbe-Anfrage: ein Coach bittet die Marketing Manager, einen Trainings-Termin zu bewerben.
model PromotionRequest {
  id                String    @id @default(cuid())
  requesterId       String
  trainingSessionId String
  note              String?
  status            String    @default("OPEN") // OPEN | FULFILLED | CLOSED
  postId            String? // Werbe-Post, der die Anfrage erfüllt hat
  createdAt         DateTime  @default(now())
  fulfilledAt       DateTime?

  requester User @relation("PromotionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([trainingSessionId])
  @@index([requesterId])
}
