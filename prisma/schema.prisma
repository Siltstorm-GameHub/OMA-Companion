// ── Ranglisten-Snapshot ───────────────────────────────────────────────────────

model LeaderboardRankSnapshot {
  id       String   @id @default(cuid())
  takenAt  DateTime @default(now())
  // JSON: { [userId]: rank } – Rang jedes Users zum Snapshot-Zeitpunkt
  dataJson String
}

// ── Push-Benachrichtigungen ──────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("userid")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("createdat")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pushsubscription")
}

// ── Community-Gameserver ─────────────────────────────────────────────────────

model GameServer {
  id            String   @id @default(cuid())
  name          String
  game          String // Freitext, z.B. "Minecraft", "ARK: Survival Ascended"
  description   String?
  host          String // IP/Domain – nur für genehmigte User sichtbar
  port          String?
  password      String? // Server-Passwort – nur für genehmigte User sichtbar
  ampInstanceId String? // AMP-Controller Instance-ID für Live-Status/Spielerzahl
  maxSlots      Int
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications ServerApplication[]

  @@map("gameserver")
}

model ServerApplication {
  id              String    @id @default(cuid())
  serverId        String
  userId          String
  status          String    @default("pending") // pending | approved | denied | revoked
  message         String?
  adminNote       String?
  appliedAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  lastConnectedAt DateTime? // Zeitpunkt des letzten Klicks auf "Jetzt verbinden" (Info für Admins)

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId, status])
  @@map("serverapplication")
}

// ── Mancave (neues Ausbausystem, parallel zum alten Gaming-Zimmer) ─────────────

/// Stufe (0-4) eines Mancave-Ausbau-Slots. Katalog (Label, Grundausstattung
/// ja/nein, Stufenkosten) steht im Code (src/lib/mancave-items.ts), hier nur
/// wer welchen Slot auf welcher Stufe besitzt. Grundausstattungs-Slots ohne
/// eigene Zeile gelten als Stufe 1, Zusatz-Slots ohne Zeile als Stufe 0
/// (faule Materialisierung wie beim alten Room-System) — siehe
/// mancave-economy.ts loadMancaveItems().
model MancaveItem {
  userId    String
  itemKey   String // Schlüssel aus MANCAVE_ITEMS
  tier      Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemKey])
}

// ── Gaming-Zimmer ────────────────────────────────────────────────────────────

/// Zustand des Gaming-Zimmers (Flächen + Metadaten).
/// Die Zeile wird ERST beim ersten Eingriff angelegt ("faule Materialisierung"):
/// Wer die Seite nur anschaut, sieht DEFAULT_ROOM aus src/lib/room-layout.ts —
/// ohne einen einzigen Schreibzugriff. Existiert die Zeile, sind die
/// RoomItem-Zeilen die alleinige Wahrheit.
model Room {
  userId       String   @id
  wallpaperKey String   @default("tapete_raufaser") // Schlüssel aus ROOM_ITEMS, Kategorie "tapete"
  floorKey     String   @default("boden_linoleum") // Schlüssel aus ROOM_ITEMS, Kategorie "bodenbelag"
  doorSign     String? // Türschild-Freitext, max. 24 Zeichen (serverseitig gekürzt)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Ein besessenes Möbelstück. Eine Zeile = ein Exemplar.
/// Größe, Preis, Zone und Freischalt-Tags stehen NICHT hier, sondern im
/// Code-Katalog (src/lib/room-items.ts) — so lassen sich Balancing-Werte
/// ändern, ohne Daten zu migrieren. Hier steht nur, WEM es gehört und WO es steht.
model RoomItem {
  id        String   @id @default(cuid())
  userId    String
  itemKey   String // Schlüssel aus ROOM_ITEMS
  zone      String // "wall" | "floor"
  x         Int // Rasterspalte der linken oberen Ecke (0-basiert)
  y         Int // Rasterzeile der linken oberen Ecke (0-basiert)
  flipped   Boolean  @default(false) // horizontal gespiegelt
  rotation  Int      @default(0) // Boden-Objekte: 0-3, je 90° zusätzlich zur Wand-Grundausrichtung
  placed    Boolean  @default(true) // false = im Lager (besessen, aber nicht aufgestellt)
  starter   Boolean  @default(false) // Grundausstattung: gratis, nicht einlagerbar
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, placed])
}

// ── Idle-Jobs ────────────────────────────────────────────────────────────────

/// Der (höchstens eine) Idle-Job eines Users. Der Lohn läuft in Echtzeit auf und
/// wird beim Abholen FAUL berechnet — es gibt bewusst KEINEN Cron dafür
/// (gleiche Philosophie wie DailySpin: gerechnet wird nur, wenn jemand hinschaut).
model UserJob {
  userId          String    @id
  jobKey          String? // null = arbeitslos (gekündigt oder gefeuert)
  hiredAt         DateTime? // Einstellungszeitpunkt (Anzeige "Betriebszugehörigkeit")
  accrualFrom     DateTime? // Ab hier läuft unabgeholter Lohn auf; bei jedem Claim neu gesetzt
  lastClaimAt     DateTime?
  totalEarned     Int       @default(0) // Lebenszeit-Verdienst über alle Jobs (für Abzeichen)
  hireLockedUntil DateTime? // Wechselsperre: vorher kein neuer Job
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Battle Cards — Mini-Battler Kartenspiel
// ============================================
// Integriert aus dem eigenständigen "OMA Battle Cards"-Projekt. Nutzt die
// bestehende User-Tabelle oben direkt mit (battleCardUserCards /
// battleCardBattles) statt eines eigenen User-Modells.

enum CardClass {
  TANK
  DAMAGE_DEALER
  SUPPORT
}

enum CardRarity {
  STANDARD
  COMMUNITY
}

enum ActivityTier {
  GHOST // 💤 ×0.85
  NPC // 🎮 ×1.0
  GAMER // 🎖 ×1.15
  LEGENDE // 🔥 ×1.3
  OLD_MASTER // 👑 ×1.45
}

// Feste Normalangriff-Sonderregel einzelner Karten: einzelne Karten können
// feste Sonderregeln haben, z.B. Fernrohr greift immer höchste HP an.
// null/fehlend = Standard-Regel (niedrigste DEF).
enum NormalAttackTargetRule {
  LOWEST_DEFENSE
  HIGHEST_HP
  LOWEST_HP
  HIGHEST_ATTACK
  RANDOM
}

model Card {
  id         String     @id @default(cuid())
  name       String // z.B. "Bastionella"
  title      String // z.B. "Die Wächterin"
  class      CardClass
  rarity     CardRarity
  flavorText String

  // Basiswerte auf Stufe 1 (bei COMMUNITY-Karten: aus Generierung, außer überschrieben)
  baseHp                 Int
  baseAttack             Int
  baseDefense            Int
  speed                  Int // fix pro Karte, innerhalb Klassen-Spanne
  normalAttackTargetRule NormalAttackTargetRule? // null = Standard (niedrigste DEF)

  // Skills als strukturiertes JSON (flexibel für unterschiedliche Effekte)
  passivePositive Json // { name, description, trigger, effects: [...] }
  passiveNegative Json
  activeSkill     Json // { name, description, cost: 50, effects: [...] }
  ultimateSkill   Json // { name, description, cost: 100, effects: [...] }

  // Nur relevant bei rarity = COMMUNITY
  linkedDiscordId String?       @unique // Verknüpfung zum realen Community-Mitglied — 1 Karte pro Mitglied
  activityTier    ActivityTier? // aktuelle Saison-Stufe (Ghost...Old Master)
  sourceStatsJson Json? // Rohdaten-Snapshot, aus dem generiert wurde (Debugging/Nachvollziehbarkeit)

  // Override-Steuerung: welche Felder sind manuell fixiert und werden bei
  // der automatischen Saison-Generierung NICHT überschrieben.
  overriddenFields String[]  @default([])
  isAutoGenerated  Boolean   @default(false) // true = durch Pipeline erzeugt/zuletzt aktualisiert
  lastGeneratedAt  DateTime?

  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userCards UserCard[]
}

model UserCard {
  id         String   @id @default(cuid())
  userId     String
  cardId     String
  level      Int      @default(1) // 1-5
  duplicates Int      @default(1) // gesamt erhaltene Kopien (inkl. verbrauchte für Upgrades)
  inLineup   Boolean  @default(false) // Teil der aktuellen Startaufstellung (max. 5 pro User)
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId]) // ein UserCard-Eintrag pro Karte pro User
}

enum BattleResult {
  WIN
  LOSS
  DRAW
}

model Battle {
  id           String       @id @default(cuid())
  playerId     String
  opponentType String // z.B. "PVE_STANDARD", "PVP", "EVENT_BOSS"
  result       BattleResult
  teamSnapshot Json // Team-Zusammenstellung zum Zeitpunkt des Kampfes
  battleLog    Json // vollständiger Rundenverlauf für Replay/Debugging
  createdAt    DateTime     @default(now())

  player User @relation("BattleCardPlayer", fields: [playerId], references: [id])
}

// ── Karten-Packs ─────────────────────────────────────────────────────────────
// Packs lösen sich NICHT automatisch auf — Kauf/Gewinn legt nur ein
// ungeöffnetes Pack ins Inventar, geöffnet wird manuell auf /battle-cards
// (mit Öffnen-Animation im Client). PURCHASE ist zusätzlich auf maximal
// 5 Käufe/Tag begrenzt (siehe lib/battle-cards/packs.ts).

enum CardPackSource {
  PURCHASE
  WHEEL
  TUTORIAL
  GEMS_PVP_CHEST
}

// Pack-Sorte bestimmt Kartenanzahl + Community-Karten-Chance beim Öffnen,
// siehe COMMUNITY_CHANCE/PACK_CARD_COUNT in lib/battle-cards/packs.ts.
enum CardPackKind {
  STANDARD
  PREMIUM
  COMMUNITY
}

model CardPack {
  id              String         @id @default(cuid())
  userId          String
  source          CardPackSource
  kind            CardPackKind   @default(STANDARD)
  // Garantiert beim Öffnen GENAU diese Karte statt einer zufälligen Ziehung
  // (siehe openNextPack in packs.ts) — bisher nur für das Tutorial-Community-
  // Pack genutzt (garantiert die eigene Community-Karte des Users).
  guaranteedCardId String?
  createdAt       DateTime       @default(now())
  openedAt        DateTime?
  openedCardId    String? // Snapshot der gezogenen Karten-ID, rein informativ

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ── Battle-Cards-Duelle (ersetzt das alte Münzen-Duell als Herausforderung
// zwischen zwei Usern) ─────────────────────────────────────────────────────
// Löst sich sofort bei Annahme auf (kein separates "Wird gespielt" nötig —
// die Kampf-Engine ist deterministisch/serverseitig, keine Live-Eingabe).

model BattleChallenge {
  id           String    @id @default(cuid())
  challengerId String
  opponentId   String
  status       String    @default("pending") // pending | live | declined | resolved | expired
  // "DUELS" (klassisches 5v5-PvP, mit Annahme-Schritt) | "GEMS" (asynchroner Match-3-Ghost-Angriff,
  // startet direkt mit status="live", kein "pending"/Annahme) — beide zählen gemeinsam in die
  // Saison-Rangliste (siehe leaderboard.ts), sind dort aber auch einzeln filterbar.
  mode         String    @default("DUELS")
  liveBattleId String?   @unique // gesetzt während status="live", verweist auf LiveBattle.id
  battleId     String? // gesetzt sobald resolved, verweist auf Battle.id
  winnerId     String?
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  challenger User @relation("BattleChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("BattleChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, opponentId, createdAt])
}

// ── Interaktive Kämpfe (Zug-für-Zug, Spieler steuert Ziel/Ultimate-Aktivierung) ─
// Ein LiveBattle hält den seriell fortsetzbaren Kampf-Zustand (siehe
// lib/battle-engine/interactive.ts) zwischen den einzelnen Zug-Requests. Für
// PVE ist playerBId null (Team B = KI/NPC), bei PVP steuern beide Spieler
// ihre eigene Seite. Nach Abschluss wird das Ergebnis wie bisher in ein
// normales Battle (+ ggf. BattleChallenge) übernommen und LiveBattle bleibt
// nur noch als Verlaufs-Datensatz stehen (status="finished").
model LiveBattle {
  id             String   @id @default(cuid())
  // "PVE_EASY" | "PVE_MEDIUM" | "PVE_HARD" | "PVE_PUZZLE_EASY" | "PVE_PUZZLE_MEDIUM" | "PVE_PUZZLE_HARD"
  // | "PVP_CHALLENGE" | "PVP_MATCHMAKING" | "PVP_GEMS" | "CAMPAIGN_<levelId>" (campaign-levels.ts)
  // | "TOURNAMENT_<gemsTournamentId>" (siehe GemsTournament unten)
  mode           String
  playerAId      String
  playerBId      String? // null = Team B ist NPC/KI-gesteuert
  stateJson      Json
  status         String   @default("active") // active | finished
  resultBattleId String?  @unique // gesetzt sobald finished, verweist auf Battle.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  playerA User  @relation("LiveBattlePlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB User? @relation("LiveBattlePlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@index([playerAId])
  @@index([playerBId])
}

// ── OMA-Gems-Turniere (Score-Attack) ────────────────────────────────────────
// Ein Admin legt im generischen Event-Admin-Bereich (/admin/events) ein Event
// mit game === "OMA Gems" an — das hängt automatisch diesen Datensatz an.
// Alle Teilnehmer kämpfen im Zeitraum [Event.startAt, endAt] gegen dasselbe
// feste Gegner-Team (bossTeamJson, einmalig bei Erstellung erzeugt, damit die
// Ergebnisse fair vergleichbar sind), ihr bester Score zählt fürs Ranking.
// Belohnungen nutzen das bereits vorhandene Event.placementRewardsJson.
model GemsTournament {
  id                 String    @id @default(cuid())
  eventId            String    @unique
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endAt              DateTime
  difficulty         String    @default("MEDIUM") // NpcDifficulty: EASY | MEDIUM | HARD
  maxAttemptsPerUser Int       @default(3)
  bossTeamJson       String
  finalizedAt        DateTime? // gesetzt vom Cron nach Auszahlung der Platzierungsbelohnungen
  createdAt          DateTime  @default(now())

  attempts GemsTournamentAttempt[]
}

model GemsTournamentAttempt {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   GemsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bestScore    Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([tournamentId, userId])
}

// ── Battle-Cards-Kampagne ("Edelstein-Kampf", siehe campaign-levels.ts) ────
// Level-Inhalte (Gegner, Schwierigkeit, Münz-Belohnung) sind bewusst hart in
// TypeScript hinterlegt (campaign-levels.ts) statt in der DB — hier landet
// nur der Spieler-Fortschritt je Level. `levelId` referenziert die id aus
// campaign-levels.ts als freier String, keine FK (Level-Inhalte leben
// außerhalb der DB und werden per Deploy gepflegt, siehe puzzle-monsters.ts
// für dasselbe Muster bei den Schnellkampf-Gegnern).
model UserCampaignProgress {
  id          String    @id @default(cuid())
  userId      String
  levelId     String
  // Beste je erzielte Sternebewertung (1-3) für dieses Level, 0 = noch nie gewonnen.
  stars       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
}

// ── Battle-Cards-Tutorial ────────────────────────────────────────────────
// Startet, sobald ein User sein Start-Pack wählt (siehe grantStarterPick in
// starter-pick.ts) — nicht rückwirkend für User, die ihr Start-Pack schon
// vor Einführung des Tutorials gewählt hatten. Ein Saison-1-Reset (siehe
// resetAllCardOwnership) zwingt User zurück in StarterPickFlow, was dieses
// Tutorial automatisch neu startet (grantStarterPick setzt alle Felder
// zurück auf null, siehe tutorial.ts: startOrResetTutorial).
model UserTutorialProgress {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  npcBattleCompletedAt      DateTime? // Schritt 1: NPC-Kampf (Einfach) gespielt — +200 Münzen, Community-Pack
  communityCardCustomizedAt DateTime? // Schritt 2: eigene Community-Karte bearbeitet — +500 Münzen
  campaignLevel1CompletedAt DateTime? // Schritt 3: Kampagne Kapitel 1, Level 1 gewonnen — Premium-Pack
  completedAt               DateTime? // alle Schritte erledigt
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Battle-Cards-Matchmaking ("Zufallsgegner suchen") ───────────────────────
// Ein User legt sich per Warteschlangen-Eintrag rein; der nächste, der ebenfalls
// beitritt, matched sich sofort gegen den ältesten wartenden Eintrag — es startet
// direkt ein interaktiver LiveBattle (siehe oben), beide steuern ihre Seite selbst.
// matchedChallengeId wird auf dem Eintrag des zuerst Wartenden gesetzt, damit
// dessen Poll-Request den LiveBattle findet — der Eintrag wird danach von diesem
// Poll konsumiert (gelöscht).
model BattleQueueEntry {
  id                 String   @id @default(cuid())
  userId             String   @unique
  createdAt          DateTime @default(now())
  matchedChallengeId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
