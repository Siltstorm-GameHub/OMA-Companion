  pollId     String
  poll       DailyPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label      String
  gameName   String?
  steamAppId Int?
  order      Int       @default(0)
}

model DailyPollVote {
  id            String    @id @default(cuid())
  pollId        String
  poll          DailyPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
